# School OS - Next.js Dockerfile
# Build context is the repository root (monorepo).
# The app name should be passed via --build-arg APP_DIR=apps/<role>
FROM node:20-alpine AS base
WORKDIR /app
RUN npm install -g pnpm@10.33.2

ARG APP_DIR
ENV NEXT_PUBLIC_API_URL=http://localhost:4000

FROM base AS deps
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* ./
COPY ${APP_DIR}/package.json ${APP_DIR}/tsconfig.json ${APP_DIR}/next.config.mjs ./${APP_DIR}/
COPY packages/*/package.json packages/*/tsconfig.json ./packages/
RUN pnpm install --frozen-lockfile --filter school-os-${APP_DIR##*/}:...

FROM base AS builder
COPY services/api/package.json services/api/tsconfig.json ./services/api/
COPY ${APP_DIR}/package.json ${APP_DIR}/tsconfig.json ${APP_DIR}/next.config.mjs ${APP_DIR}/src ./${APP_DIR}/
COPY packages/*/package.json packages/*/tsconfig.json ./packages/
COPY packages/*/src ./packages/
RUN pnpm install --frozen-lockfile --filter school-os-${APP_DIR##*/}:...
WORKDIR /app
RUN pnpm build -F school-os-${APP_DIR##*/}...

FROM base AS runner
WORKDIR /app/${APP_DIR}
COPY --from=builder /app/${APP_DIR}/.next ./.next
COPY --from=builder /app/${APP_DIR}/public ./public
COPY --from=builder /app/${APP_DIR}/package.json ./
COPY --from=builder /app/${APP_DIR}/next.config.mjs ./
COPY --from=deps /app/node_modules ./node_modules
COPY --from=builder /app/${APP_DIR}/tsconfig.json ./
EXPOSE 3000
CMD ["pnpm", "start"]
