# ====================================================================
# School OS - Environment Configuration (ONE SCHOOL)
# ====================================================================
# Copy to .env and adjust for your machine. Never commit real secrets.

# ---- API (services/api) ----
PORT=4000
DATABASE_URL="mongodb://localhost:27017/schoolos?replicaSet=rs0"
NODE_ENV=development
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_ACCESS_TOKEN_TTL="15m"
JWT_REFRESH_TOKEN_TTL="7d"
CORS_ORIGIN="http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003"

# Redis (queues / caching)
REDIS_URL="redis://localhost:6379"

# ---- File storage ----
# Local disk provider (default). S3-compatible via env when configured.
STORAGE_PROVIDER="local"
STORAGE_LOCAL_ROOT="./services/api/uploads"
STORAGE_S3_BUCKET=""
STORAGE_S3_REGION=""
STORAGE_S3_ACCESS_KEY_ID=""
STORAGE_S3_SECRET_ACCESS_KEY=""

# ---- Email / messaging ----
RESEND_API_KEY=""
FROM_EMAIL="School OS <noreply@school.example>"

# ---- SMS gateway ----
# The SMS Centre composes, resolves recipients, tracks campaigns and reports
# delivery from whichever gateway is selected here. With no credentials set it
# records a campaign as blocked rather than pretending it was sent, so the
# settings below are what turns sending on.
#
# SMS_PROVIDER selects the adapter: africastalking (default, Kenya/East Africa)
# or termii (Nigeria/West Africa).
SMS_PROVIDER="africastalking"
# Provider credentials. Africa's Talking needs the API key plus a username
# (`sandbox` for the sandbox environment, your account username for live).
SMS_API_KEY=""
SMS_USERNAME=""
# The registered alphanumeric sender. Must be approved by the provider.
SMS_SENDER_ID=""
# Overrides the provider base URL. Use the sandbox host while testing:
#   https://api.sandbox.africastalking.com   (Africa's Talking)
#   https://sandbox.termii.com               (Termii)
SMS_BASE_URL=""
# Shared secret a delivery report must present. Without it the delivery route
# refuses every report rather than accepting one it cannot verify.
SMS_WEBHOOK_SECRET=""

# ---- Currency (KES / Kenyan Shillings) ----
APP_CURRENCY="KES"
APP_CURRENCY_SYMBOL="KSh"
APP_CURRENCY_MINOR_UNIT="cents"

# ---- Seed (first run creates a super admin) ----
SEED_ADMIN_EMAIL="admin@school.example"
SEED_ADMIN_PASSWORD="supersecret"

# ---- Apps ----
# Frontend app URLs (used by API for redirects / cookies).
APP_STUDENT_URL="http://localhost:3000"
APP_TEACHER_URL="http://localhost:3001"
APP_PARENT_URL="http://localhost:3002"
APP_ADMIN_URL="http://localhost:3003"
