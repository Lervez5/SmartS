// ====================================================================
// INVENTORY
// ====================================================================

model Asset {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  tag                String?   @unique
  name               String
  category           String?
  purchasePriceCents Int?
  currency           String    @default("KES")
  purchaseDate       DateTime?
  status             String    @default("in_use") // in_use | in_repair | retired
  location           String?
  createdAt          DateTime  @default(now())
}

// ====================================================================
// SYSTEM
// ====================================================================

model AuditLog {
  id     String  @id @default(auto()) @map("_id") @db.ObjectId
  user   User?   @relation(fields: [userId], references: [id])
  userId String? @db.ObjectId

  /// The school this entry belongs to.
  ///
  /// An audit trail is a record of what a school did, so it belongs to that
  /// school. Without this the log was global: reading it showed every school's
  /// administrative history, and a school had no way to see only its own.
  ///
  /// Resolved from the actor's membership when it is not passed explicitly, so
  /// every existing write path is scoped without changing all of them.
  school   School? @relation(fields: [schoolId], references: [id])
  schoolId String? @db.ObjectId

  action    String
  details   String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([schoolId])
  @@index([schoolId, createdAt])
}

model Invitation {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  email     String
  roleId    String?   @db.ObjectId
  role      Role?     @relation(fields: [roleId], references: [id])
  token     String    @unique
  status    String    @default("pending") // pending | accepted | expired
  invitedBy String?   @db.ObjectId
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

model EmailLog {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  to        String
  subject   String
  type      String
  status    String
  error     String?
  sentAt    DateTime?
  createdAt DateTime  @default(now())
}

model SystemSetting {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Institution and school-scoped configuration
//
// The platform is multi-institution in the data model even though it is
// deployed for one school first: every school-scoped record carries a
// schoolId, so adding a second institution is a deployment concern rather than
// a rewrite. Personal user preferences are deliberately separate from these
// records and live in UserPersonalSettings.
// ---------------------------------------------------------------------------

model School {
  id                 String  @id @default(auto()) @map("_id") @db.ObjectId
  name               String
  displayName        String?
  registrationNumber String?
  schoolCode         String? @unique
  schoolType         String?
  schoolLevel        String?
  curriculum         String?
  yearEstablished    Int?
  motto              String?
  vision             String?
  mission            String?
  description        String?

  phone           String?
  email           String?
  altPhone        String?
  altEmail        String?
  website         String?
  admissionsEmail String?
  admissionsPhone String?
  financeEmail    String?
  financePhone    String?

  country         String?
  county          String?
  subCounty       String?
  town            String?
  postalAddress   String?
  postalCode      String?
  physicalAddress String?
  latitude        Float?
  longitude       Float?

  principalName  String?
  principalEmail String?
  principalPhone String?

  status    SchoolStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  memberships             SchoolMembership[]
  generalSettings         SchoolGeneralSettings?
  brandingSettings        SchoolBrandingSettings?
  academicSettings        SchoolAcademicSettings?
  financeSettings         SchoolFinanceSettings?
  subscriptionSettings    SchoolSubscriptionSettings?
  notificationSettings    SchoolNotificationSettings?
  securitySettings        SchoolSecuritySettings?
  glowSettings            SchoolGlowSettings?
  competencyBands         CompetencyBand[]
  racefieldScales         RacefieldScale[]
  academicYears           AcademicYear[]
  classes                 Class[]
  subjects                Subject[]
  streamAllocations       StreamAllocation[]
  enrollmentBatches       EnrollmentBatch[]
  courses                 Course[]
  auditLogs               AuditLog[]
  smsCampaigns            SmsCampaign[]
  smsOptOuts              SmsOptOut[]
  smsAutomationRules      SmsAutomationRule[]
  enrollmentNotifications EnrollmentNotification[]

  @@index([status])
}

enum SchoolStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

/// Which institution a user belongs to. Authorises the scope of every
/// school-scoped read and write.
model SchoolMembership {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @db.ObjectId
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId  String   @db.ObjectId
  isDefault Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([userId, schoolId])
  @@index([schoolId])
}

/// School profile settings: identity, contact, location, leadership.
model SchoolGeneralSettings {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId String @unique @db.ObjectId

  name               String
  displayName        String?
  registrationNumber String?
  schoolCode         String?
  schoolType         String?
  schoolLevel        String?
  curriculum         String?
  yearEstablished    Int?
  motto              String?
  vision             String?
  mission            String?
  description        String?

  phone           String?
  email           String?
  altPhone        String?
  altEmail        String?
  website         String?
  admissionsEmail String?
  admissionsPhone String?
  financeEmail    String?
  financePhone    String?

  country         String?
  county          String?
  subCounty       String?
  town            String?
  postalAddress   String?
  postalCode      String?
  physicalAddress String?
  latitude        Float?
  longitude       Float?

  principalName  String?
  principalEmail String?
  principalPhone String?

  updatedAt DateTime @updatedAt
}

/// Visual identity consumed by every portal, report and communication.
model SchoolBrandingSettings {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId String @unique @db.ObjectId

  logoUrl     String?
  logoAltText String?
  faviconUrl  String?

  /// A photograph of the institution, shown on the sign-in screen in place of
  /// any generated artwork. Optional: the screen falls back to a quiet branded
  /// panel when none is set.
  coverImageUrl      String?
  coverImageAltText  String?
  primaryColor       String?
  secondaryColor     String?
  accentColor        String?
  portalNameOverride String?
  loginNameOverride  String?
  reportFooter       String?
  emailFooter        String?
  invoiceFooter      String?
  receiptFooter      String?
  /// Applies branding to the student/teacher/parent/admin portals.
  applyToPortals     Boolean @default(true)
  /// Applies branding to generated reports and documents.
  applyToReports     Boolean @default(true)
  /// Applies branding to outgoing email.
  applyToEmail       Boolean @default(true)
  /// Applies branding to invoices and receipts.
  applyToFinance     Boolean @default(true)

  updatedAt DateTime @updatedAt
}

/// Configures academic behaviour. Operational data stays owned by Academics.
model SchoolAcademicSettings {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId String @unique @db.ObjectId

  /// Session behaviour
  currentAcademicYearId String?
  academicYearFormat    String?
  termsPerYear          Int     @default(3)
  weekStart             Int     @default(1)
  termStartDay          Int     @default(1)

  /// Attendance
  attendanceRequired     Boolean @default(true)
  attendanceGraceMinutes Int     @default(15)
  autoMarkAbsent         Boolean @default(false)
  allowLateArrival       Boolean @default(true)

  /// Assessment
  enableContinuousAssessment Boolean @default(false)
  endOfTermExamWeight        Int     @default(70)
  continuousAssessmentWeight Int     @default(30)
  minimumCompetencyLevel     String?

  /// Grading
  gradingSystem      String?
  gradeScaleId       String?
  promotionRule      String?
  automaticPromotion Boolean @default(false)

  /// Timetable
  timetablePeriodsPerDay Int     @default(8)
  timetableStartTime     String?
  timetableEndTime       String?

  /// Competency-based assessment (CBC-oriented)
  enableCompetencyFramework Boolean @default(false)
  competencyLevels          String? /// JSON array of levels
  assessmentTypes           String? /// JSON array
  rubricEnabled             Boolean @default(false)
  portfoliosEnabled         Boolean @default(false)
  evidenceTrackingEnabled   Boolean @default(false)
  projectsEnabled           Boolean @default(false)

  updatedAt DateTime @updatedAt
}

/// Configures financial behaviour. Invoices, payments, arrears, refunds,
/// credit notes and reconciliation records stay owned by the Finance modules.
model SchoolFinanceSettings {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId String @unique @db.ObjectId

  currency             String  @default("KES")
  currencySymbol       String?
  currencyPosition     String?
  decimalPlaces        Int     @default(2)
  fiscalYearStartMonth Int     @default(1)

  feeCategories      String? /// JSON array
  billingPeriod      String?
  invoicePrefix      String?
  receiptPrefix      String?
  receiptFooter      String?
  termsAndConditions String?

  paymentMethods       String? /// JSON array
  allowPartialPayments Boolean @default(true)
  allowOverpayment     Boolean @default(false)
  arrearsEnabled       Boolean @default(true)
  arrearsGraceDays     Int     @default(14)
  latePaymentPenalty   Float?

  discountsEnabled            Boolean @default(false)
  waiversEnabled              Boolean @default(false)
  refundsEnabled              Boolean @default(false)
  creditNotesEnabled          Boolean @default(false)
  reconciliationEnabled       Boolean @default(true)
  financeNotificationsEnabled Boolean @default(true)

  updatedAt DateTime @updatedAt
}

/// Subscription and plan configuration. Foundation only: the platform has no
/// billing provider wired up, so no operational subscription controls are
/// exposed here until one exists.
model SchoolSubscriptionSettings {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId String @unique @db.ObjectId

  planCode           String?
  planName           String?
  billingCycle       String?
  seats              Int?
  renewsAt           DateTime?
  status             String?
  providerConfigured Boolean   @default(false)
  providerReference  String?

  updatedAt DateTime @updatedAt
}

/// School-wide notification behaviour. Every event key must correspond to a
/// real notification consumer in the notifications module.
model SchoolNotificationSettings {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId String @unique @db.ObjectId

  defaultChannel String  @default("in_app")
  emailEnabled   Boolean @default(true)
  smsEnabled     Boolean @default(false)
  pushEnabled    Boolean @default(false)
  inAppEnabled   Boolean @default(true)

  senderName    String?
  senderEmail   String?
  smsSenderId   String?
  smsProvider   String?
  emailProvider String?

  /// Per-event channel matrix, stored as a JSON object keyed by event name.
  eventMatrix String?

  quietHoursEnabled Boolean @default(false)
  quietHoursStart   String?
  quietHoursEnd     String?

  updatedAt DateTime @updatedAt
}

/// School-level security policy consumed by the central auth service.
model SchoolSecuritySettings {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId String @unique @db.ObjectId

  requireMfaForStaff         Boolean @default(false)
  passwordMinLength          Int     @default(8)
  passwordRequireUppercase   Boolean @default(true)
  passwordRequireNumber      Boolean @default(true)
  passwordRequireSymbol      Boolean @default(false)
  passwordExpiryDays         Int?
  maxFailedLogins            Int     @default(5)
  lockoutMinutes             Int     @default(15)
  sessionTimeoutMinutes      Int     @default(480)
  requireActivation          Boolean @default(true)
  allowPasswordReset         Boolean @default(true)
  passwordResetExpiryMinutes Int     @default(30)
  enforceHttps               Boolean @default(true)

  updatedAt DateTime @updatedAt
}

/// Daily Glow configuration. The Daily Glow experience does not exist in the
/// codebase yet; these fields are the configuration surface it will read, and
/// no behavioural controls are exposed until it is implemented completely.
model SchoolGlowSettings {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId String @unique @db.ObjectId

  enabled        Boolean @default(false)
  headline       String?
  message        String?
  audience       String?
  cadence        String?
  contentSources String?
  implemented    Boolean @default(false)

  updatedAt DateTime @updatedAt
}

/// Personal preferences for one user. Never mixed into school settings.
model UserPersonalSettings {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique @db.ObjectId

  theme                    String?
  language                 String?
  timezone                 String?
  dateFormat               String?
  currency                 String?
  emailNotifications       Boolean @default(true)
  smsNotifications         Boolean @default(false)
  pushNotifications        Boolean @default(false)
  inAppNotifications       Boolean @default(true)
  marketingOptIn           Boolean @default(false)
  profileVisibility        String?
  teachingPreferences      String?
  communicationPreferences String?
  learningPreferences      String?

  updatedAt DateTime @updatedAt
}

// ====================================================================
// SMS CENTRE
// ====================================================================

/// Decides how a campaign's recipients are resolved: a staff-chosen audience,
/// or the guardians of learners with an outstanding balance.
enum SmsCampaignPurpose {
  bulk
  balance_reminder
}

/// Lifecycle of a campaign. `accepted_by_provider` is the gateway acknowledging
/// the request; only a delivery report sets `delivered`. `blocked` means it could
/// not be handed off at all - no gateway, or no recipient.
enum SmsCampaignStatus {
  draft
  submitted
  accepted_by_provider
  delivered
  rejected
  failed
  blocked
  cancelled
}

/// `skipped` is before any provider call (no number, opted out);
/// `failed` means the provider was asked and refused.
enum SmsRecipientStatus {
  pending
  queued
  submitted
  accepted
  delivered
  failed
  skipped
}

/// A messaging run: one body, sent once, to a set of guardians.
/// Recipients are resolved server-side and stored per ParentProfile, never
/// from a client-supplied count.
model SmsCampaign {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId String @db.ObjectId

  purpose SmsCampaignPurpose @default(bulk)
  status  SmsCampaignStatus  @default(draft)

  /// SMS has no subject line. This is an internal label for the campaign, shown
  /// in history, and is never sent to the provider as a header.
  subject String?
  body    String

  /// How the body was segmented by the encoding-aware estimator, so the
  /// recorded cost matches what was actually submitted.
  segmentsPerMessage Int    @default(1)
  encoding           String @default("GSM-7")

  recipientCount Int @default(0)
  deliveredCount Int @default(0)
  failedCount    Int @default(0)
  skippedCount   Int @default(0)

  /// Provider-assigned message identifier, when the provider supplies one.
  providerMessageId String?
  /// Why the provider refused, or why sending was blocked.
  providerError     String?

  /// Guards against a double submission. The client derives a key when it
  /// starts composing and sends it back on confirm, so a repeated click, a
  /// browser retry or a worker retry resolves to the one campaign rather than
  /// creating a second.
  idempotencyKey String? @unique

  submittedAt DateTime?

  createdBy     String? @db.ObjectId
  createdByUser User?   @relation("SmsCampaignsCreated", fields: [createdBy], references: [id])

  recipients SmsRecipient[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId, createdAt])
  @@index([schoolId, status])
  @@index([schoolId, purpose])
}

/// One guardian in one campaign. A guardian linked to several learners in the
/// same audience appears once, not once per learner. `studentProfileId` records
/// which learner's placement produced the row.
model SmsRecipient {
  id         String      @id @default(auto()) @map("_id") @db.ObjectId
  campaign   SmsCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId String      @db.ObjectId

  /// The guardian this message is addressed to.
  parentProfile   ParentProfile? @relation(fields: [parentProfileId], references: [id])
  parentProfileId String?        @db.ObjectId

  /// The learner whose placement or balance produced this recipient. Null for a
  /// broadcast the staff member composed without naming learners.
  studentProfile   StudentProfile? @relation(fields: [studentProfileId], references: [id])
  studentProfileId String?         @db.ObjectId

  /// The number the provider was asked to send to, stored as normalised E.164
  /// where a country code could be determined, otherwise as recorded.
  phone String

  status     SmsRecipientStatus @default(pending)
  /// Why it was skipped - no phone number, opted out, not eligible.
  skipReason String?

  providerMessageId String?
  providerStatus    String?
  /// Provider-side failure reason, kept distinct from skipReason.
  error             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campaignId, parentProfileId])
  @@index([campaignId, status])
  @@index([parentProfileId])
}

/// A guardian who has asked not to be sent SMS. Checked at resolution and again
/// before submission, so neither a bulk send nor an automated reminder can bypass
/// it. Per guardian rather than per number: changing number does not opt back in.
model SmsOptOut {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  parentProfile   ParentProfile @relation(fields: [parentProfileId], references: [id], onDelete: Cascade)
  parentProfileId String        @unique @db.ObjectId
  reason          String?
  createdAt       DateTime      @default(now())
  school          School?       @relation(fields: [schoolId], references: [id])
  schoolId        String?       @db.ObjectId
}

/// A configured automation rule: what the school wants, when, and whether an
/// administrator enabled it. A rule causes no message on its own - a run resolves
/// the audience and prepares a draft campaign for a person to confirm.
model SmsAutomationRule {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId String @db.ObjectId

  name    String
  purpose SmsCampaignPurpose @default(balance_reminder)

  /// Whether an administrator wants this rule to run. Enabling a rule requires
  /// sms.manage, and enabling one does not cause anything to happen on its own.
  enabled Boolean @default(false)

  /// Days between runs, and how overdue a balance must be to be eligible.
  everyDays           Int @default(7)
  overdueAfterDays    Int @default(0)
  /// Ignore balances below this, in minor units, so a rounding-difference debt
  /// does not generate a message.
  minOutstandingCents Int @default(0)

  /// Per-guardian cooldown, so a re-run does not remind the same guardian again.
  /// Checked against that guardian's last reminder, not the rule's last run.
  cooldownDays Int @default(7)

  subject String?
  body    String

  lastRunAt      DateTime?
  lastRunStatus  String?
  lastRunMessage String?

  createdBy     String? @db.ObjectId
  createdByUser User?   @relation("SmsAutomationRulesCreated", fields: [createdBy], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId, enabled])
}

// ====================================================================
// ENROLLMENT NOTIFICATIONS
// ====================================================================

/// Why a message exists, which decides how it is worded and whether it is
/// essential. Enrollment and activation messages are essential and are sent even
/// to a parent who has opted out of other school messaging, because they carry
/// information the family needs to act on rather than a promotion.
enum NotificationType {
  enrollment_confirmation
  account_activation
  enrollment_and_activation
}

/// Which transport carried an enrollment message.
///
/// Distinct from `NotificationChannel`, which is the in-app notification
/// channel: these two are different things and sharing one enum would let an
/// enrollment SMS be recorded as `in_app`, which no gateway can deliver.
enum EnrollmentChannel {
  sms
  email
}

/// Lifecycle of a single outbound message.
///
/// `provider_accepted` is deliberately distinct from `delivered`: the former is
/// the gateway acknowledging it received the request, and only a provider
/// delivery report may set the latter. `awaiting_contact` is its own state
/// because a guardian with no usable number or address is not a failure - the
/// message was never attempted - and it needs to be visible to staff as an
/// actionable task rather than counted as an error.
enum NotificationStatus {
  pending
  queued
  provider_accepted
  delivered
  failed
  awaiting_contact
  awaiting_retry
  cancelled
}

/// One message to one guardian about one enrollment.
/// Keyed by an idempotency key derived from the enrollment, guardian and
/// channel, so retries resolve to the same row.
model EnrollmentNotification {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId String @db.ObjectId

  /// The enrollment this message is about. Required - a notification that is not
  /// about a real placement is noise.
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  enrollmentId String     @db.ObjectId

  /// The learner being enrolled, so a guardian with several children produces
  /// one message per enrollment rather than one ambiguous summary.
  student   StudentProfile? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String?         @db.ObjectId

  /// The guardian being contacted, resolved from ParentChildLink. Never a bare
  /// phone number: a recipient who cannot be identified cannot be deduplicated
  /// or suppressed.
  parent   ParentProfile? @relation(fields: [parentId], references: [id], onDelete: Cascade)
  parentId String?        @db.ObjectId

  type    NotificationType
  channel EnrollmentChannel
  status  NotificationStatus @default(pending)

  /// Where the message went, as normalised by the sending side. Masked in every
  /// API response; the full value is never returned.
  destination String?

  subject String?
  /// The rendered body, stored so a retry does not depend on the template
  /// still matching what was first attempted, and so staff can see what was
  /// actually sent.
  body    String

  /// Provider's own identifier for the message, when it returns one.
  providerMessageId String?
  /// Provider's rejection or failure reason.
  providerError     String?

  /// Deduplicates a re-fired trigger. Unique, so the database is the last line
  /// of defence against a duplicate send.
  idempotencyKey String @unique

  attemptCount  Int       @default(0)
  lastAttemptAt DateTime?
  queuedAt      DateTime?
  sentAt        DateTime?
  deliveredAt   DateTime?

  /// Set when this row is the activation instruction for the guardian, so an
  /// activation link is never sent twice for the same invitation.
  invitationId String? @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enrollmentId])
  @@index([schoolId, createdAt])
  @@index([schoolId, status])
  @@index([parentId])
  @@index([status, queuedAt])
}
