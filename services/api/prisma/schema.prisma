  amountCents Int // KSH minor units
  currency    String    @default("KES")
  status      String    @default("pending") // pending | paid | void
  issuedAt    DateTime  @default(now())
  dueDate     DateTime
  paidAt      DateTime?
  lineItems   Json?
  receipts    Receipt[] @relation("InvoiceReceipts")

  @@index([studentId])
}

model Receipt {
  id            String              @id @default(auto()) @map("_id") @db.ObjectId
  transactionId String?             @db.ObjectId
  transaction   FinanceTransaction? @relation("ReceiptTransaction", fields: [transactionId], references: [id])
  invoiceId     String?             @db.ObjectId
  invoice       Invoice?            @relation("InvoiceReceipts", fields: [invoiceId], references: [id])
  number        String              @unique
  amountCents   Int // KSH minor units
  currency      String              @default("KES")
  method        String // cash | mpesa | bank_transfer | card
  paidBy        String?             @db.ObjectId
  paidByName    String?
  receivedAt    DateTime            @default(now())

  @@index([transactionId])
  @@index([invoiceId])
}

model Expense {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
