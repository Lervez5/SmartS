  title        String
  description  String?
  type         CalendarEventType @default(class_session)
  startDate    DateTime
  endDate      DateTime?
  allDay       Boolean           @default(false)
  classId      String?           @db.ObjectId
  assignmentId String?           @db.ObjectId
  createdBy    String            @db.ObjectId
  visibility   String            @default("personal") // personal | class | school
  color        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

