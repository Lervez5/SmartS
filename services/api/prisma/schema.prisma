enum SmsCampaignPurpose {
  bulk
  balance_reminder
}

/// `accepted_by_provider` = gateway ack; only a delivery report may set `delivered`.
/// `blocked` = could not be handed off (no gateway or no recipient).
enum SmsCampaignStatus {
  draft
  submitted
  accepted_by_provider
  delivered
  rejected
  failed
  blocked
  cancelled
}

/// `skipped` = before provider call (no number, opted out); `failed` = provider refused.
enum SmsRecipientStatus {
  pending
  queued
  submitted
  accepted
  delivered
  failed
  skipped
}

/// Recipients are resolved server-side and stored per ParentProfile, never from a
/// client-supplied count.
model SmsCampaign {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId String @db.ObjectId

  purpose SmsCampaignPurpose @default(bulk)
  status  SmsCampaignStatus  @default(draft)

  /// Internal label shown in history — never sent to the provider.
  subject String?
  body    String

  /// Segmentation as computed by the encoding-aware estimator, so recorded cost matches submission.
  segmentsPerMessage Int    @default(1)
  encoding           String @default("GSM-7")

  recipientCount Int @default(0)
  deliveredCount Int @default(0)
  failedCount    Int @default(0)
  skippedCount   Int @default(0)

  providerMessageId String?
  providerError     String?

  /// Prevents double-submit: client derives the key when composing; repeated clicks resolve to the same campaign.
  idempotencyKey String? @unique

  submittedAt DateTime?

  createdBy     String? @db.ObjectId
  createdByUser User?   @relation("SmsCampaignsCreated", fields: [createdBy], references: [id])

  recipients SmsRecipient[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId, createdAt])
  @@index([schoolId, status])
  @@index([schoolId, purpose])
}

/// A guardian linked to several learners in the same audience appears once.
/// studentProfileId records which learner's placement produced the row.
model SmsRecipient {
  id         String      @id @default(auto()) @map("_id") @db.ObjectId
  campaign   SmsCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId String      @db.ObjectId

  parentProfile   ParentProfile? @relation(fields: [parentProfileId], references: [id])
  parentProfileId String?        @db.ObjectId

  /// Null for a broadcast not tied to specific learners.
  studentProfile   StudentProfile? @relation(fields: [studentProfileId], references: [id])
  studentProfileId String?         @db.ObjectId

  /// Normalised E.164 where a country code was determinable, otherwise as recorded.
  phone String

  status     SmsRecipientStatus @default(pending)
  skipReason String?

  providerMessageId String?
  providerStatus    String?
  error             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campaignId, parentProfileId])
  @@index([campaignId, status])
  @@index([parentProfileId])
}

/// Checked at resolution and again before submission — neither bulk nor automated send can bypass it.
/// Per guardian, not per number: changing number does not opt back in.
model SmsOptOut {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  parentProfile   ParentProfile @relation(fields: [parentProfileId], references: [id], onDelete: Cascade)
  parentProfileId String        @unique @db.ObjectId
  reason          String?
  createdAt       DateTime      @default(now())
  school          School?       @relation(fields: [schoolId], references: [id])
  schoolId        String?       @db.ObjectId
}

/// A rule causes no message on its own — a run resolves the audience and prepares a
/// draft campaign for a human to confirm.
model SmsAutomationRule {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId String @db.ObjectId

  name    String
  purpose SmsCampaignPurpose @default(balance_reminder)

  /// Enabling requires sms.manage permission. Enabling alone causes nothing to happen.
  enabled Boolean @default(false)

  everyDays        Int @default(7)
  overdueAfterDays Int @default(0)
  /// Ignore balances below this (minor units) — avoids messages for rounding-difference debts.
  minOutstandingCents Int @default(0)

  /// Per-guardian cooldown checked against that guardian's last reminder, not the rule's last run.
  cooldownDays Int @default(7)

  subject String?
  body    String

  lastRunAt      DateTime?
  lastRunStatus  String?
  lastRunMessage String?

  createdBy     String? @db.ObjectId
  createdByUser User?   @relation("SmsAutomationRulesCreated", fields: [createdBy], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId, enabled])
}

/// enrollment_confirmation and account_activation are essential — sent even to
/// opted-out parents because they carry action items, not promotions.
enum NotificationType {
  enrollment_confirmation
  account_activation
  enrollment_and_activation
}

/// Distinct from NotificationChannel — sharing one enum would allow an enrollment
/// SMS to be recorded as in_app, which no gateway can deliver.
enum EnrollmentChannel {
  sms
  email
}

/// `provider_accepted` = gateway ack; only a delivery report may set `delivered`.
/// `awaiting_contact` = no usable number/address — actionable gap for staff, not an error.
enum NotificationStatus {
  pending
  queued
  provider_accepted
  delivered
  failed
  awaiting_contact
  awaiting_retry
  cancelled
}

/// Idempotency key derived from enrollment + guardian + channel — retries resolve
/// to the same row. Unique at DB level as the last defence against duplicate sends.
model EnrollmentNotification {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId String @db.ObjectId

  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  enrollmentId String     @db.ObjectId

  /// One message per enrollment per child — a guardian with several children gets separate rows.
  student   StudentProfile? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String?         @db.ObjectId

  /// Resolved from ParentChildLink. A bare phone number can't be deduplicated or suppressed.
  parent   ParentProfile? @relation(fields: [parentId], references: [id], onDelete: Cascade)
  parentId String?        @db.ObjectId

  type    NotificationType
  channel EnrollmentChannel
  status  NotificationStatus @default(pending)

  /// Masked in every API response.
  destination String?

  subject String?
  /// Stored rendered body so a retry doesn't depend on the template matching what was first attempted.
  body    String

  providerMessageId String?
  providerError     String?

  idempotencyKey String @unique

  attemptCount  Int       @default(0)
  lastAttemptAt DateTime?
  queuedAt      DateTime?
  sentAt        DateTime?
  deliveredAt   DateTime?

  /// Set when this row carries the activation link — ensures the link is never sent twice.
  invitationId String? @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enrollmentId])
  @@index([schoolId, createdAt])
  @@index([schoolId, status])
  @@index([parentId])
  @@index([status, queuedAt])
}
