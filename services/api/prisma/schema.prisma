  book       LibraryBook @relation(fields: [bookId], references: [id])
  bookId     String      @db.ObjectId
  studentId  String?     @db.ObjectId
  student    User?       @relation(fields: [studentId], references: [id])
  borrowedAt DateTime    @default(now())
  dueDate    DateTime
  returnedAt DateTime?

  @@index([bookId])
  @@index([studentId])
