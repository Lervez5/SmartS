  user      User?                @relation(fields: [userId], references: [id])
  userId    String?              @db.ObjectId
  title     String
  body      String?
  channel   NotificationChannel  @default(in_app)
  priority  NotificationPriority @default(medium)
  read      Boolean              @default(false)
  readAt    DateTime?
  actionUrl String?
  createdAt DateTime             @default(now())

  @@index([userId])
}

// ====================================================================
// DOCUMENTS
// ====================================================================

model Document {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  description  String?
  fileUrl      String
  fileSize     Int?
  mimeType     String?
  category     String?
  uploadedById String?  @db.ObjectId
  visibility   String   @default("private") // private | shared | public
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ====================================================================
// FINANCE (all currency stored in KSH / KES minor units - cents)
// ====================================================================

model FinanceAccount {
  id           String               @id @default(auto()) @map("_id") @db.ObjectId
  code         String               @unique
  name         String
  type        String // asset | liability | income | expense | equity
  currency     String               @default("KES")
  createdAt    DateTime             @default(now())
  transactions FinanceTransaction[]
}

model FinanceTransaction {
  id          String                   @id @default(auto()) @map("_id") @db.ObjectId
  accountId   String                   @db.ObjectId
  account     FinanceAccount           @relation(fields: [accountId], references: [id])
  type        FinanceTransactionType
  status      FinanceTransactionStatus @default(draft)
  amountCents Int
  currency    String                   @default("KES")
  description String?
  reference   String?
  relatedId   String? // invoice/receipt/contract id
  postedAt    DateTime?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  receipts Receipt[] @relation("ReceiptTransaction")

  @@index([accountId])
  @@index([relatedId])
}

model Invoice {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  studentId   String?   @db.ObjectId
  student     User?     @relation("StudentInvoices", fields: [studentId], references: [id])
  number      String    @unique
  amountCents Int
  currency    String    @default("KES")
  status      String    @default("pending")
  issuedAt    DateTime  @default(now())
  dueDate     DateTime
  paidAt      DateTime?
  lineItems   Json?
  receipts    Receipt[] @relation("InvoiceReceipts")

  @@index([studentId])
}

model Receipt {
  id            String              @id @default(auto()) @map("_id") @db.ObjectId
  transactionId String?             @db.ObjectId
  transaction   FinanceTransaction? @relation("ReceiptTransaction", fields: [transactionId], references: [id])
  invoiceId     String?             @db.ObjectId
  invoice       Invoice?            @relation("InvoiceReceipts", fields: [invoiceId], references: [id])
  number        String              @unique
  amountCents   Int // KSH minor units
  currency      String              @default("KES")
  method        String
  paidBy        String?             @db.ObjectId
  paidByName    String?
  receivedAt    DateTime            @default(now())

  @@index([transactionId])
  @@index([invoiceId])
}

model Expense {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  categoryId  String?          @db.ObjectId
  category    ExpenseCategory? @relation(fields: [categoryId], references: [id])
  amountCents Int // KSH minor units
  currency    String           @default("KES")
  description String
  status      ExpenseStatus    @default(pending)
  paidAt      DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model ExpenseCategory {
  id       String    @id @default(auto()) @map("_id") @db.ObjectId
  name     String    @unique
  code     String?   @unique
  expenses Expense[]
}

// ====================================================================
// PAYROLL & STAFF
// ====================================================================

model PayrollRun {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  periodStart DateTime
  periodEnd   DateTime
  status      PayrollStatus @default(pending)
  totalCents  Int
  currency    String        @default("KES")
  processedAt DateTime?
  createdAt   DateTime      @default(now())

  payslips Payslip[]
}

model Payslip {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  payrollRunId    String        @db.ObjectId
  payrollRun      PayrollRun    @relation(fields: [payrollRunId], references: [id])
  staffId         String        @db.ObjectId
  grossCents      Int
  deductionsCents Int
  netCents        Int
  currency        String        @default("KES")
  status          PayrollStatus @default(pending)
  createdAt       DateTime      @default(now())

  @@index([payrollRunId])
}

// ====================================================================
// TRANSPORT
// ====================================================================

model TransportRoute {
  id          String                @id @default(auto()) @map("_id") @db.ObjectId
  code        String                @unique
  name        String
  startPoint  String
  endPoint    String
  stops       String[]
  fareCents   Int?
  currency    String                @default("KES")
  createdAt   DateTime              @default(now())
  assignments TransportAssignment[]
}

model TransportAssignment {
  id        String         @id @default(auto()) @map("_id") @db.ObjectId
  studentId String?        @db.ObjectId
  student   User?          @relation(fields: [studentId], references: [id])
  routeId   String         @db.ObjectId
  route     TransportRoute @relation(fields: [routeId], references: [id])

  @@index([studentId])
  @@index([routeId])
}

// ====================================================================
// LIBRARY
// ====================================================================

model LibraryBook {
  id              String             @id @default(auto()) @map("_id") @db.ObjectId
  isbn            String?            @unique
  title           String
  author          String?
  category        String?
  copiesTotal     Int                @default(1)
  copiesAvailable Int
  createdAt       DateTime           @default(now())
  borrowings      LibraryBorrowing[]
