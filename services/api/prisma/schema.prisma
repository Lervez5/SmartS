generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ====================================================================
// ENUMERATIONS
// ====================================================================

enum UserRole {
  SUPER_ADMIN
  ACCOUNTANT
  DEAN
  TEACHER
  PARENT
  STUDENT
}

enum UserStatus {
  pending
  active
  suspended
  archived
}

enum Gender {
  male
  female
  other
  unspecified
}

enum AdmissionStatus {
  pending
  accepted
  rejected
  withdrawn
  enrolled
}

enum AttendanceStatus {
  present
  absent
  late
  excused
  sick
  on_leave
}

enum CalendarEventType {
  class_session
  assignment_due
  quiz
  examination
  school_event
  holiday
  personal_reminder
  meeting
}

enum CourseStatus {
  draft
  published
  archived
}

enum SubmissionStatus {
  pending
  graded
}

enum GradeScale {
  letter
  percentage
  gpa
}

enum NotificationChannel {
  in_app
  email
  sms
}

enum NotificationPriority {
  low
  medium
  high
  urgent
}

enum FinanceTransactionType {
  invoice
  payment
  receipt
  refund
  credit
  debit
}

enum FinanceTransactionStatus {
  draft
  posted
  void
  cancelled
}

enum ExpenseStatus {
  pending
  approved
  paid
  cancelled
}

enum PayrollStatus {
  pending
  processed
  paid
  cancelled
}

enum StaffStatus {
  active
  on_leave
  terminated
  archived
}

// ====================================================================
// ROLES & PERMISSIONS (granular, permission-driven)
// ====================================================================

model Role {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  name            String           @unique
  description     String?
  rolePermissions RolePermission[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  roleMemberships UserRoleMembership[]
  invitations     Invitation[]
}

model Permission {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  key         String  @unique // e.g. "students.read", "attendance.write", "finance.invoice"
  name        String
  description String?
  domain      String // e.g. "students", "attendance", "finance"

  rolePermissions RolePermission[]
}

model RolePermission {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  roleId       String     @db.ObjectId
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])
  permissionId String     @db.ObjectId

  @@index([roleId])
  @@index([permissionId])
}

model UserRoleMembership {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @db.ObjectId
  role      Role     @relation(fields: [roleId], references: [id])
  roleId    String   @db.ObjectId
  createdAt DateTime @default(now())

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

// ====================================================================
// USERS & PEOPLE
// ====================================================================

model User {
  id                   String     @id @default(auto()) @map("_id") @db.ObjectId
  email                String     @unique
  firstName            String?
  lastName             String?
  name                 String?
  avatar               String?
  phone                String?
  status               UserStatus @default(pending)
  passwordHash         String?
  passwordResetToken   String?
  passwordResetExpires DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  // Session revocation: increment to invalidate all existing tokens.
  sessionTokenVersion Int @default(0)

  // Role-based access (a user may hold multiple roles)
  roleMemberships   UserRoleMembership[]
  schoolMemberships SchoolMembership[]
  personalSettings  UserPersonalSettings?

  // People profiles (one-to-one per role type)
  studentProfile StudentProfile?
  staffProfile   StaffProfile?
  parentProfile  ParentProfile?

  // Auth / sessions
  auditLogs     AuditLog[]
  exitsRecorded LearnerExit[]  @relation("ExitRecordedBy")
  exitsRestored LearnerExit[]  @relation("ExitRestoredBy")
  notifications Notification[]

  // Back-references for relations from other models
  teacherClasses       Class[]               @relation("TeacherClasses")
  classAssistants      ClassAssistant[]      @relation("ClassAssistants")
  teachingAssignments  TeachingAssignment[]  @relation("TeachingAssignments")
  teacherCourses       Course[]              @relation("TeacherCourses")
  enrollments          Enrollment[]          @relation("StudentEnrollments")
  courseEnrollments    CourseEnrollment[]    @relation("StudentCourseEnrollments")
  submissions          Submission[]          @relation("StudentSubmissions")
  examAttempts         ExamAttempt[]         @relation("StudentExamAttempts")
  grades               Grade[]               @relation("StudentGrades")
  lessonAccessLogs     LessonAccessLog[]
  attendance           Attendance[]          @relation("StudentAttendance")
  invoices             Invoice[]             @relation("StudentInvoices")
  transportAssignments TransportAssignment[]
  libraryBorrowings    LibraryBorrowing[]
}

model StudentProfile {
  id                   String                @id @default(auto()) @map("_id") @db.ObjectId
  user                 User                  @relation(fields: [userId], references: [id])
  userId               String                @unique @db.ObjectId
  admissionId          String?               @db.ObjectId
  dateOfBirth          DateTime?
  gender               Gender?
  gradeLevel           String?
  enrollmentDate       DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  parentLinks          ParentChildLink[]
  admissionApplication AdmissionApplication?
  exits                LearnerExit[]
}

model StaffProfile {
  id         String      @id @default(auto()) @map("_id") @db.ObjectId
  user       User        @relation(fields: [userId], references: [id])
  userId     String      @unique @db.ObjectId
  employeeId String?
  hireDate   DateTime?
  position   String?
  department String?
  status     StaffStatus @default(active)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model ParentProfile {
  id        String            @id @default(auto()) @map("_id") @db.ObjectId
  user      User              @relation(fields: [userId], references: [id])
  userId    String            @unique @db.ObjectId
  children  ParentChildLink[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model ParentChildLink {
  id        String         @id @default(auto()) @map("_id") @db.ObjectId
  parentId  String         @db.ObjectId
  parent    ParentProfile  @relation(fields: [parentId], references: [id])
  childId   String         @db.ObjectId
  child     StudentProfile @relation(fields: [childId], references: [id])
  createdAt DateTime       @default(now())

  @@unique([parentId, childId])
}

// ====================================================================
// ADMISSIONS
// ====================================================================

model AdmissionApplication {
  id          String              @id @default(auto()) @map("_id") @db.ObjectId
  applicantId String              @unique @db.ObjectId
  applicant   StudentProfile      @relation(fields: [applicantId], references: [id])
  status      AdmissionStatus     @default(pending)
  appliedAt   DateTime            @default(now())
  reviewedAt  DateTime?
  reviewedBy  String?             @db.ObjectId
  notes       String?
  documents   AdmissionDocument[]
}

model AdmissionDocument {
  id            String               @id @default(auto()) @map("_id") @db.ObjectId
  application   AdmissionApplication @relation(fields: [applicationId], references: [id])
  applicationId String               @db.ObjectId
  name          String
  fileUrl       String?
  uploadedAt    DateTime             @default(now())
}

// ====================================================================
// ACADEMICS
// ====================================================================

model Subject {
  id                  String               @id @default(auto()) @map("_id") @db.ObjectId
  name                String
  code                String?
  description         String?
  topics              Topic[]
  lessons             Lesson[]
  classes             Class[]              @relation("SubjectClasses")
  courses             Course[]
  examinations        Examination[]        @relation("SubjectExams")
  grades              Grade[]              @relation("SubjectGrades")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  school              School               @relation(fields: [schoolId], references: [id])
  schoolId            String               @db.ObjectId
  examinationSubjects ExaminationSubject[]
  teachingAssignments TeachingAssignment[]

  @@unique([schoolId, name])
  @@unique([schoolId, code])
}

model Topic {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  subject   Subject  @relation(fields: [subjectId], references: [id])
  subjectId String   @db.ObjectId
  lessons   Lesson[]
}

model Lesson {
  id         String            @id @default(auto()) @map("_id") @db.ObjectId
  title      String
  subject    Subject?          @relation(fields: [subjectId], references: [id])
  subjectId  String?           @db.ObjectId
  topic      Topic?            @relation(fields: [topicId], references: [id])
  topicId    String?           @db.ObjectId
  unit       Unit?             @relation(fields: [unitId], references: [id])
  unitId     String?           @db.ObjectId
  lessonType String            @default("note") // video | pdf | note | interactive
  content    String?
  fileUrl    String?
  duration   Int? // in seconds
  difficulty Float? // 0..1
  exercises  Exercise[]
  accessLogs LessonAccessLog[] @relation("LessonAccessLogs")
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
}

model Exercise {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  lesson     Lesson?  @relation(fields: [lessonId], references: [id])
  lessonId   String?  @db.ObjectId
  prompt     String
  maxScore   Float
  difficulty Float?
  createdAt  DateTime @default(now())
}

// ====================================================================
// ACADEMIC SESSIONS
//
// An AcademicYear is the school's academic session (2026, 2026/27). A Term is
// an individual academic period inside a session, so the two are kept
// distinct rather than collapsed into one record.
//
// The session is the unit that other domains are measured against: invoices and
// receipts are counted within a session's dates, and learner enrolments are
// attributed to the session they joined in. That makes the session the shared
// context the admin navbar resolves and the other modules read.
// ====================================================================

enum AcademicSessionStatus {
  planned
  active
  completed
  archived
}

enum TermStatus {
  planned
  active
  completed
}

enum LearnerExitReason {
  completed
  transferred
  withdrawn
}

/// The Kenyan CBC performance levels.
///
/// These are the four levels the curriculum defines, ordered from strongest.
/// The boundaries between them are school configuration, not a constant: see
/// CompetencyBand.
enum CompetencyLevel {
  /// Exceeds Expectation
  EE
  /// Meets Expectation
  ME
  /// Approaches Expectation
  AE
  /// Below Expectation
  BE
}

enum StreamStatus {
  active
  inactive
  archived
}

enum AssessmentStatus {
  draft
  published
  completed
  archived
}

model AcademicYear {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  /// The school this session belongs to. An academic session is
  /// per-institution: without its own scope, every school's "current session"
  /// would resolve to whichever record happened to be written last.
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId String @db.ObjectId

  /// Unique per school rather than globally, since two schools both running a
  /// "2026" session is normal and one must not block the other.
  name                String // e.g. 2026
  label               String? // display label, e.g. "2026 Academic Session"
  startDate           DateTime
  endDate             DateTime
  /// Only one session is `active` at a time; the service enforces it.
  status              AcademicSessionStatus @default(planned)
  terms               Term[]
  examinations        Examination[]
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  learnerExits        LearnerExit[]
  teachingAssignments TeachingAssignment[]

  @@unique([schoolId, name])
  @@index([status])
  @@index([schoolId])
}

model Term {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  academicYearId String        @db.ObjectId
  academicYear   AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  name           String // e.g. "Term 1"
  termNumber     Int
  startDate      DateTime
  endDate        DateTime
  status         TermStatus    @default(planned)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  examinations   Examination[]

  @@unique([academicYearId, termNumber])
  @@index([status])
}

model Course {
  id                 String             @id @default(auto()) @map("_id") @db.ObjectId
  title              String
  description        String?
  code               String?            @unique
  category           String?
  status             CourseStatus       @default(draft)
  learningObjectives String[]
  teacher            User?              @relation("TeacherCourses", fields: [teacherId], references: [id])
  teacherId          String?            @db.ObjectId
  subject            Subject?           @relation(fields: [subjectId], references: [id])
  subjectId          String?            @db.ObjectId
  modules            Module[]
  enrollments        CourseEnrollment[]
  classes            Class[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model Module {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  order       Int
  course      Course   @relation(fields: [courseId], references: [id])
  courseId    String   @db.ObjectId
  units       Unit[]
  createdAt   DateTime @default(now())
}

model Unit {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  order       Int
  module      Module?      @relation(fields: [moduleId], references: [id])
  moduleId    String?      @db.ObjectId
  lessons     Lesson[]
  assignments Assignment[] @relation("UnitAssignments")
  createdAt   DateTime     @default(now())
}

model CourseEnrollment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  student   User?    @relation("StudentCourseEnrollments", fields: [studentId], references: [id])
  studentId String?  @db.ObjectId
  course    Course   @relation(fields: [courseId], references: [id])
  courseId  String   @db.ObjectId
  progress  Float    @default(0)
  status    String   @default("active") // active | completed | dropped
  createdAt DateTime @default(now())
}

// ====================================================================
// CLASSES, ENROLLMENTS, SCHEDULE
// ====================================================================

/// The learning areas a summative assessment covers.
///
/// Results are entered per learning area, so the applicable areas are a property
/// of the assessment rather than a single subject: a paper that assesses
/// Mathematics and Science is one assessment with two areas, not two
/// assessments.
model ExaminationSubject {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  examination   Examination @relation(fields: [examinationId], references: [id], onDelete: Cascade)
  examinationId String      @db.ObjectId
  subject       Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId     String      @db.ObjectId

  @@unique([examinationId, subjectId])
  @@index([subjectId])
}

/// Who teaches which learning area to which class.
///
/// This is the real allocation unit. A class offers many learning areas, and a
/// teacher is responsible for a subset of them in a given class - the maths
/// teacher of 7 Blue is not automatically entitled to enter English marks there.
/// Recording that per pairing is also what makes result entry accountable: a
/// mark is attributable to the teacher allocated to that learning area, rather
/// than to whoever holds a TEACHER role.
model TeachingAssignment {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId String @db.ObjectId

  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId String  @db.ObjectId

  teacher   User   @relation("TeachingAssignments", fields: [teacherId], references: [id])
  teacherId String @db.ObjectId

  /// Whether this teacher may enter results for the pairing. Allocation and
  /// entry rights are separate: a school can allocate a teacher to a class for a
  /// term without letting them finalise marks.
  canEnterResults Boolean       @default(true)
  /// The session the allocation applies to, when it is term-specific.
  academicYearId  String?       @db.ObjectId
  academicYear    AcademicYear? @relation(fields: [academicYearId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classId, subjectId, teacherId])
  @@index([teacherId])
  @@index([subjectId])
}

model Class {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  /// A class belongs to one school. This is also what makes the class teacher
  /// and the assistant class teacher meaningful: they are staff of this school
  /// teaching this class.
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId String @db.ObjectId

  name        String
  description String?

  /// The class's primary or home learning area.
  ///
  /// A class offers several learning areas and each is taught by an assigned
  /// teacher, which TeachingAssignment records. This is the single area a class
  /// is named or timetabled against, so a shortcut rather than the allocation
  /// model. Two schools can both teach Mathematics: the subject is scoped to a
  /// school and unique within it.
  subject   Subject? @relation("SubjectClasses", fields: [subjectId], references: [id])
  subjectId String?  @db.ObjectId

  classCode           String?              @unique
  gradeLevel          String?
  teacher             User?                @relation("TeacherClasses", fields: [teacherId], references: [id])
  teacherId           String?              @db.ObjectId
  /// responsible for the same class as the main teacher, and which of them may
  /// manage it is recorded per assignment.
  assistants          ClassAssistant[]
  courseId            String?              @db.ObjectId
  course              Course?              @relation(fields: [courseId], references: [id])
  enrollments         Enrollment[]
  assignments         Assignment[]         @relation("ClassAssignments")
  attendance          Attendance[]         @relation("ClassAttendance")
  schedules           ClassSchedule[]
  streams             Stream[]
  examinations        Examination[]        @relation("ClassExams")
  grades              Grade[]              @relation("ClassGrades")
  schedule            DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  teachingAssignments TeachingAssignment[]
}

model Enrollment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  student   User?    @relation("StudentEnrollments", fields: [studentId], references: [id])
  studentId String?  @db.ObjectId
  class     Class    @relation(fields: [classId], references: [id])
  classId   String   @db.ObjectId
  createdAt DateTime @default(now())
  stream    Stream?  @relation(fields: [streamId], references: [id])
  streamId  String?  @db.ObjectId

  @@unique([studentId, classId])
}

model ClassSchedule {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  class      Class     @relation(fields: [classId], references: [id])
  classId    String    @db.ObjectId
  dayOfWeek  Int // 0=Sun .. 6=Sat
  startTime  String // "HH:MM" 24h
  endTime    String // "HH:MM" 24h
  room       String?
  recurrence String    @default("weekly") // weekly | biweekly | daily
  validFrom  DateTime
  validUntil DateTime?
  createdAt  DateTime  @default(now())
}

// ====================================================================
// ASSIGNMENTS, SUBMISSIONS, EXAMINATIONS, GRADING & LMS
// ====================================================================

model Assignment {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  dueDate     DateTime
  class       Class?       @relation("ClassAssignments", fields: [classId], references: [id])
  classId     String?      @db.ObjectId
  unit        Unit?        @relation("UnitAssignments", fields: [unitId], references: [id])
  unitId      String?      @db.ObjectId
  rubric      String?
  maxScore    Float?
  submissions Submission[]
  grades      Grade[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Submission {
  id           String           @id @default(auto()) @map("_id") @db.ObjectId
  assignment   Assignment       @relation(fields: [assignmentId], references: [id])
  assignmentId String           @db.ObjectId
  student      User?            @relation("StudentSubmissions", fields: [studentId], references: [id])
  studentId    String?          @db.ObjectId
  content      String?
  fileUrl      String?
  score        Float?
  feedback     String?
  rubricScores Json?
  status       SubmissionStatus @default(pending)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model Examination {
  id             String               @id @default(auto()) @map("_id") @db.ObjectId
  title          String
  /// Lifecycle state. `draft` is not visible to learners; `published` opens the
  /// assessment; `completed` locks marks entry.
  status         AssessmentStatus     @default(draft)
  /// Free text rather than an enum because the permitted values are school
  /// policy: SchoolAcademicSettings.assessmentTypes lists what the school uses.
  assessmentType String?
  /// The authoritative academic context, so a summative assessment belongs to
  /// the same session and term the navbar selects rather than to loose dates.
  academicYearId String?              @db.ObjectId
  academicYear   AcademicYear?        @relation(fields: [academicYearId], references: [id])
  termId         String?              @db.ObjectId
  term           Term?                @relation(fields: [termId], references: [id])
  description    String?
  class          Class?               @relation("ClassExams", fields: [classId], references: [id])
  classId        String?              @db.ObjectId
  /// Subject is the learning-area analogue the platform currently carries.
  subject        Subject?             @relation("SubjectExams", fields: [subjectId], references: [id])
  subjectId      String?              @db.ObjectId
  startDate      DateTime
  endDate        DateTime?
  duration       Int? // minutes
  maxScore       Float?
  examAttempts   ExamAttempt[]
  grades         Grade[]              @relation("ExamGrades")
  learningAreas  ExaminationSubject[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([academicYearId])
  @@index([termId])
  @@index([status])
}

model ExamAttempt {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  examination   Examination @relation(fields: [examinationId], references: [id])
  examinationId String      @db.ObjectId
  student       User?       @relation("StudentExamAttempts", fields: [studentId], references: [id])
  studentId     String?     @db.ObjectId
  score         Float?
  graded        Boolean     @default(false)
  submittedAt   DateTime?
  createdAt     DateTime    @default(now())
}

/// A record that a learner has left the school.
///
/// Kept on StudentProfile rather than as a separate entity so the learner keeps
/// one identity: their attendance, grades, attempts, documents, invoices and
/// parent links stay attached to the same record the Alumni Office reads.
/// A restore never deletes a row, it stamps restoredAt, so the archive and its
/// reversal both remain auditable.
model LearnerExit {
  id        String            @id @default(auto()) @map("_id") @db.ObjectId
  student   StudentProfile    @relation(fields: [studentId], references: [id])
  studentId String            @db.ObjectId
  reason    LearnerExitReason
  exitDate  DateTime          @default(now())

  /// Level and stream the learner was in when they left. Stream is free text
  /// because the schema has no Stream model; it is null when none was assigned.
  lastGradeLevel String?
  lastStream     String?

  /// The academic session the exit falls in, so the archive is scoped the same
  /// way every other academic record is.
  academicYearId String?       @db.ObjectId
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id])

  /// Where they went, for a transfer.
  destination String?
  notes       String?

  recordedBy   User?    @relation("ExitRecordedBy", fields: [recordedById], references: [id])
  recordedById String?  @db.ObjectId
  recordedAt   DateTime @default(now())

  /// Set when the learner is re-enrolled. An exit with no restoredAt is the
  /// learner's current state, which is what the Alumni Office lists.
  ///
  /// Note: the field must be written explicitly as null on create rather than
  /// omitted. MongoDB's `$eq: null` matches an explicit null but not a missing
  /// key, so an omitted field would make the unresolved-exit filter - and
  /// therefore the whole Alumni list - come back empty.
  restoredAt   DateTime?
  restoredBy   User?     @relation("ExitRestoredBy", fields: [restoredById], references: [id])
  restoredById String?   @db.ObjectId

  createdAt DateTime @default(now())

  @@index([reason])
  @@index([academicYearId])
  @@index([restoredAt])
}

/// Where one CBC competency level begins and ends, as a share of the
/// assessment's maximum score.
///
/// Configured per school rather than hardcoded, because the curriculum sets the
/// levels but not the cut-offs a school chooses between them. Ordered by
/// `minPercent`; the lowest band is open-ended downwards and the highest
/// open-ended upwards.
model CompetencyBand {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  school      School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId    String          @db.ObjectId
  level       CompetencyLevel
  /// Human label, so the interface never has to expand the enum.
  label       String
  /// Inclusive lower bound, 0-100. Bands are matched on the learner's score as a
  /// percentage of the assessment maximum.
  minPercent  Float
  /// Inclusive upper bound. Null on the highest band, which runs to 100.
  maxPercent  Float?
  /// Short note shown where a band is explained, e.g. on a report.
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  grades Grade[]

  @@unique([schoolId, level])
  @@index([schoolId])
}

/// A subdivision of a class.
///
/// A stream never replaces the class: attendance, timetabling and assessment all
/// stay anchored to the class, and the stream is how a class is split into
/// teaching groups within it. It therefore carries no teacher of its own -
/// responsibility belongs to the class's main teacher and assistants, and a
/// stream-level assignment would compete with that rather than extend it.
model Stream {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  class Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  /// Unique within the class, since two streams in one class cannot share a code.
  classId  String       @db.ObjectId
  name     String
  code     String
  /// Optional ordering within the class, where a school numbers its streams.
  capacity Int?
  status   StreamStatus @default(active)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments Enrollment[]

  @@unique([classId, code])
  @@index([classId])
  @@index([status])
}

/// An assistant class teacher, with the rights that assignment grants.
///
/// `canManage` is what lets a school give an assistant the same operational
/// rights as the main class teacher, or fewer. It is recorded on the assignment
/// rather than inferred from a global role, so being a TEACHER never implies
/// authority over a class one was not assigned to.
model ClassAssistant {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId String @db.ObjectId

  assistant   User   @relation("ClassAssistants", fields: [assistantId], references: [id])
  assistantId String @db.ObjectId

  /// Whether this assistant may manage the class, or may only view it.
  canManage Boolean @default(true)

  createdAt DateTime @default(now())

  @@unique([classId, assistantId])
  @@index([assistantId])
}

model Grade {
  id               String           @id @default(auto()) @map("_id") @db.ObjectId
  student          User?            @relation("StudentGrades", fields: [studentId], references: [id])
  studentId        String?          @db.ObjectId
  subject          Subject?         @relation("SubjectGrades", fields: [subjectId], references: [id])
  subjectId        String?          @db.ObjectId
  class            Class?           @relation("ClassGrades", fields: [classId], references: [id])
  classId          String?          @db.ObjectId
  exam             Examination?     @relation("ExamGrades", fields: [examinationId], references: [id])
  examinationId    String?          @db.ObjectId
  assignment       Assignment?      @relation(fields: [assignmentId], references: [id])
  assignmentId     String?          @db.ObjectId
  scale            GradeScale
  value            Float
  /// The CBC competency level this score falls into, resolved against the
  /// school's CompetencyBand boundaries when the grade was recorded.
  competencyLevel  CompetencyLevel?
  competencyBand   CompetencyBand?  @relation(fields: [competencyBandId], references: [id])
  competencyBandId String?          @db.ObjectId
  comment          String?
  gradedAt         DateTime         @default(now())
  gradedBy         String?          @db.ObjectId
}

model LessonAccessLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  student    User?    @relation(fields: [studentId], references: [id])
  studentId  String?  @db.ObjectId
  lesson     Lesson?  @relation("LessonAccessLogs", fields: [lessonId], references: [id])
  lessonId   String?  @db.ObjectId
  accessedAt DateTime @default(now())
  durationMs Int      @default(0)
}

