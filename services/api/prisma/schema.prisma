generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ACCOUNTANT
  DEAN
  TEACHER
  PARENT
  STUDENT
}

enum UserStatus {
  pending
  active
  suspended
  archived
}

enum Gender {
  male
  female
  other
  unspecified
}

enum AdmissionStatus {
  pending
  accepted
  rejected
  withdrawn
  enrolled
}

/// Responsibilities, not roles. A person can hold main_class_teacher and
/// subject_teacher simultaneously — the two sit side by side.
enum StreamResponsibility {
  main_class_teacher
  assistant_class_teacher
  subject_teacher
}

enum AllocationStatus {
  active
  inactive
}

enum AttendanceStatus {
  present
  absent
  late
  excused
  sick
  on_leave
}

enum CalendarEventType {
  class_session
  assignment_due
  quiz
  examination
  school_event
  holiday
  personal_reminder
  meeting
}

enum CourseStatus {
  draft
  published
  archived
}

enum SubmissionStatus {
  pending
  graded
}

enum GradeScale {
  letter
  percentage
  gpa
}

enum NotificationChannel {
  in_app
  email
  sms
}

enum NotificationPriority {
  low
  medium
  high
  urgent
}

enum FinanceTransactionType {
  invoice
  payment
  receipt
  refund
  credit
  debit
}

enum FinanceTransactionStatus {
  draft
  posted
  void
  cancelled
}

enum ExpenseStatus {
  pending
  approved
  paid
  cancelled
}

enum PayrollStatus {
  pending
  processed
  paid
  cancelled
}

enum StaffStatus {
  active
  on_leave
  terminated
  archived
}

model Role {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  name            String           @unique
  description     String?
  rolePermissions RolePermission[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  roleMemberships UserRoleMembership[]
  invitations     Invitation[]
}

model Permission {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  key         String  @unique // e.g. "students.read", "attendance.write"
  name        String
  description String?
  domain      String  // e.g. "students", "attendance", "finance"

  rolePermissions RolePermission[]
}

model RolePermission {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  roleId       String     @db.ObjectId
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])
  permissionId String     @db.ObjectId

  @@index([roleId])
  @@index([permissionId])
}

model UserRoleMembership {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @db.ObjectId
  role      Role     @relation(fields: [roleId], references: [id])
  roleId    String   @db.ObjectId
  createdAt DateTime @default(now())

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model User {
  id                   String     @id @default(auto()) @map("_id") @db.ObjectId
  email                String     @unique
  firstName            String?
  lastName             String?
  name                 String?
  avatar               String?
  phone                String?
  status               UserStatus @default(pending)
  passwordHash         String?
  passwordResetToken   String?
  passwordResetExpires DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  sessionTokenVersion Int @default(0)

  roleMemberships   UserRoleMembership[]
  schoolMemberships SchoolMembership[]
  personalSettings  UserPersonalSettings?

  studentProfile StudentProfile?
  staffProfile   StaffProfile?
  parentProfile  ParentProfile?

  auditLogs     AuditLog[]
  exitsRecorded LearnerExit[]  @relation("ExitRecordedBy")
  exitsRestored LearnerExit[]  @relation("ExitRestoredBy")
  notifications Notification[]

  teacherClasses            Class[]               @relation("TeacherClasses")
  classAssistants           ClassAssistant[]      @relation("ClassAssistants")
  teachingAssignments       TeachingAssignment[]  @relation("TeachingAssignments")
  streamAllocations         StreamAllocation[]    @relation("StreamAllocations")
  placementHistories        PlacementHistory[]
  placementActions          PlacementHistory[]    @relation("PlacementActionBy")
  teacherCourses            Course[]              @relation("TeacherCourses")
  enrollments               Enrollment[]          @relation("StudentEnrollments")
  courseEnrollments         CourseEnrollment[]    @relation("StudentCourseEnrollments")
  submissions               Submission[]          @relation("StudentSubmissions")
  examAttempts              ExamAttempt[]         @relation("StudentExamAttempts")
  grades                    Grade[]               @relation("StudentGrades")
  lessonAccessLogs          LessonAccessLog[]
  smsCampaignsCreated       SmsCampaign[]         @relation("SmsCampaignsCreated")
  smsAutomationRulesCreated SmsAutomationRule[]   @relation("SmsAutomationRulesCreated")
  attendance                Attendance[]          @relation("StudentAttendance")
  invoices                  Invoice[]             @relation("StudentInvoices")
  transportAssignments      TransportAssignment[]
  libraryBorrowings         LibraryBorrowing[]
}

model StudentProfile {
  id                   String                   @id @default(auto()) @map("_id") @db.ObjectId
  user                 User                     @relation(fields: [userId], references: [id])
  userId               String                   @unique @db.ObjectId
  admissionId          String?                  @db.ObjectId
  dateOfBirth          DateTime?
  gender               Gender?
  gradeLevel           String?
  enrollmentDate       DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  parentLinks          ParentChildLink[]
  admissionApplication AdmissionApplication?
  exits                LearnerExit[]
  smsRecipients        SmsRecipient[]
  notifications        EnrollmentNotification[]
}

model StaffProfile {
  id         String      @id @default(auto()) @map("_id") @db.ObjectId
  user       User        @relation(fields: [userId], references: [id])
  userId     String      @unique @db.ObjectId
  employeeId String?
  hireDate   DateTime?
  position   String?
  department String?
  status     StaffStatus @default(active)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model ParentProfile {
  id            String                   @id @default(auto()) @map("_id") @db.ObjectId
  user          User                     @relation(fields: [userId], references: [id])
  userId        String                   @unique @db.ObjectId
  children      ParentChildLink[]
  smsRecipients SmsRecipient[]
  smsOptOut     SmsOptOut?
  notifications EnrollmentNotification[]
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
}

model ParentChildLink {
  id        String         @id @default(auto()) @map("_id") @db.ObjectId
  parentId  String         @db.ObjectId
  parent    ParentProfile  @relation(fields: [parentId], references: [id])
  childId   String         @db.ObjectId
  child     StudentProfile @relation(fields: [childId], references: [id])
  createdAt DateTime       @default(now())

  @@unique([parentId, childId])
}

model AdmissionApplication {
  id          String              @id @default(auto()) @map("_id") @db.ObjectId
  applicantId String              @unique @db.ObjectId
  applicant   StudentProfile      @relation(fields: [applicantId], references: [id])
  status      AdmissionStatus     @default(pending)
  appliedAt   DateTime            @default(now())
  reviewedAt  DateTime?
  reviewedBy  String?             @db.ObjectId
  notes       String?
  documents   AdmissionDocument[]
}

model AdmissionDocument {
  id            String               @id @default(auto()) @map("_id") @db.ObjectId
  application   AdmissionApplication @relation(fields: [applicationId], references: [id])
  applicationId String               @db.ObjectId
  name          String
  fileUrl       String?
  uploadedAt    DateTime             @default(now())
}

enum EnrollmentBatchStatus {
  draft
  completed
  abandoned
}

/// `duplicate` is separate from `failed`: a row whose email already exists is a
/// decision (skip or attach), not an error. Failed means the row was unprocessable.
enum EnrollmentEntryStatus {
  pending
  enrolled
  duplicate
  failed
}

model EnrollmentBatch {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId String @db.ObjectId

  status EnrollmentBatchStatus @default(draft)

  source String?
  notes  String?

  totalRows      Int @default(0)
  enrolledCount  Int @default(0)
  duplicateCount Int @default(0)
  failedCount    Int @default(0)

  /// Plain reference — deleting a staff account must not cascade-delete the batch they ran.
  createdById String? @db.ObjectId

  entries   EnrollmentBatchEntry[]
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  @@index([schoolId])
  @@index([schoolId, createdAt])
}

model EnrollmentBatchEntry {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  batch   EnrollmentBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  batchId String          @db.ObjectId

  rowNumber Int

  /// Decides which profile is created: STUDENT → StudentProfile, PARENT → ParentProfile, staff → StaffProfile.
  role UserRole @default(STUDENT)

  status EnrollmentEntryStatus @default(pending)

  /// Email is the join key — an existing email is what makes a row a duplicate.
  email     String
  firstName String?
  lastName  String?
  phone     String?

  gradeLevel      String?
  dateOfBirth     DateTime?
  gender          Gender?
  admissionNumber String?
  /// Validated to belong to the caller's school before anything is written.
  classId         String?   @db.ObjectId
  streamId        String?   @db.ObjectId
  academicYearId  String?   @db.ObjectId
  /// Matched by email, not id — that's what an operator has when pasting a roster.
  parentEmail     String?

  employeeId String?
  position   String?
  department String?
  hireDate   DateTime?

  userId String? @db.ObjectId
  error  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([batchId])
  @@index([batchId, status])
  @@index([batchId, email])
}

model Subject {
  id                  String               @id @default(auto()) @map("_id") @db.ObjectId
  name                String
  code                String?
  description         String?
  topics              Topic[]
  lessons             Lesson[]
  classes             Class[]              @relation("SubjectClasses")
  courses             Course[]
  examinations        Examination[]        @relation("SubjectExams")
  grades              Grade[]              @relation("SubjectGrades")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  school              School               @relation(fields: [schoolId], references: [id])
  schoolId            String               @db.ObjectId
  examinationSubjects ExaminationSubject[]
  teachingAssignments TeachingAssignment[]
  streamAllocations   StreamAllocation[]
  gradeLevels         SubjectGradeLevel[]

  status LearningAreaStatus @default(active)
  origin LearningAreaOrigin @default(custom)

  /// `all` = taught across every grade; `selected` = restricted to entries in gradeLevels.
  gradeScope GradeScope @default(all)

  @@unique([schoolId, name])
  @@unique([schoolId, code])
  @@index([schoolId, status])
  @@index([schoolId, origin])
}

/// Only present when gradeScope = selected. gradeLevel is the school's own
/// vocabulary (Class.gradeLevel), never hardcoded. Deliberately not reusing
/// Class.subjectId, which is a class's home area and must not double as a grade filter.
model SubjectGradeLevel {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId String  @db.ObjectId

  gradeLevel String
  createdAt  DateTime @default(now())

  @@unique([subjectId, gradeLevel])
  @@index([gradeLevel])
}

model Topic {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  subject   Subject  @relation(fields: [subjectId], references: [id])
  subjectId String   @db.ObjectId
  lessons   Lesson[]
}

model Lesson {
  id         String            @id @default(auto()) @map("_id") @db.ObjectId
  title      String
  subject    Subject?          @relation(fields: [subjectId], references: [id])
  subjectId  String?           @db.ObjectId
  topic      Topic?            @relation(fields: [topicId], references: [id])
  topicId    String?           @db.ObjectId
  unit       Unit?             @relation(fields: [unitId], references: [id])
  unitId     String?           @db.ObjectId
  lessonType String            @default("note") // video | pdf | note | interactive
  content    String?
  fileUrl    String?
  duration   Int?              // seconds
  difficulty Float?            // 0..1
  exercises  Exercise[]
  accessLogs LessonAccessLog[] @relation("LessonAccessLogs")
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
}

model Exercise {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  lesson     Lesson?  @relation(fields: [lessonId], references: [id])
  lessonId   String?  @db.ObjectId
  prompt     String
  maxScore   Float
  difficulty Float?
  createdAt  DateTime @default(now())
}

enum AcademicSessionStatus {
  planned
  active
  completed
  archived
}

enum TermStatus {
  planned
  active
  completed
}

enum LearnerExitReason {
  completed
  transferred
  withdrawn
}

/// Kenyan CBC performance levels. Band boundaries are school config — see CompetencyBand.
enum CompetencyLevel {
  EE // Exceeds Expectation
  ME // Meets Expectation
  AE // Approaches Expectation
  BE // Below Expectation
}

enum StreamStatus {
  active
  inactive
  archived
}

enum ClassStatus {
  active
  inactive
  archived
}

/// `custom` = school-defined, school may rename/retire.
/// `curriculum` = arrived via sync; editing here silently diverges from the source.
enum LearningAreaOrigin {
  custom
  curriculum
}

enum LearningAreaStatus {
  active
  inactive
  archived
}

/// `all` is an explicit choice, not the absence of one — an empty gradeLevels list
/// would otherwise be ambiguous between "everywhere" and "not configured yet".
enum GradeScope {
  all
  selected
}

enum AssessmentStatus {
  draft
  published
  completed
  archived
}

model AcademicYear {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId String @db.ObjectId

  /// Unique per school, not globally — two schools can both run a "2026" session.
  name                String
  label               String?
  startDate           DateTime
  endDate             DateTime
  /// Enforced by the service: only one active at a time.
  status              AcademicSessionStatus @default(planned)
  terms               Term[]
  examinations        Examination[]
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  learnerExits        LearnerExit[]
  teachingAssignments TeachingAssignment[]
  streamAllocations   StreamAllocation[]
  classes             Class[]
  streams             Stream[]
  enrollments         Enrollment[]
  placementHistories  PlacementHistory[]

  @@unique([schoolId, name])
  @@index([status])
  @@index([schoolId])
}

model Term {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  academicYearId String        @db.ObjectId
  academicYear   AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  name           String
  termNumber     Int
  startDate      DateTime
  endDate        DateTime
  status         TermStatus    @default(planned)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  examinations   Examination[]

  @@unique([academicYearId, termNumber])
  @@index([status])
}

model Course {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  /// schoolId was missing, leaving every course query unscoped and letting one
  /// school read another's courses.
  school             School?            @relation(fields: [schoolId], references: [id])
  schoolId           String?            @db.ObjectId
  title              String
  description        String?
  code               String?            @unique
  category           String?
  status             CourseStatus       @default(draft)
  learningObjectives String[]
  teacher            User?              @relation("TeacherCourses", fields: [teacherId], references: [id])
  teacherId          String?            @db.ObjectId
  subject            Subject?           @relation(fields: [subjectId], references: [id])
  subjectId          String?            @db.ObjectId
  modules            Module[]
  enrollments        CourseEnrollment[]
  classes            Class[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([schoolId])
  @@index([schoolId, status])
}

model Module {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  order       Int
  course      Course   @relation(fields: [courseId], references: [id])
  courseId    String   @db.ObjectId
  units       Unit[]
  createdAt   DateTime @default(now())
}

model Unit {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  order       Int
  module      Module?      @relation(fields: [moduleId], references: [id])
  moduleId    String?      @db.ObjectId
  lessons     Lesson[]
  assignments Assignment[] @relation("UnitAssignments")
  createdAt   DateTime     @default(now())
}

model CourseEnrollment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  student   User?    @relation("StudentCourseEnrollments", fields: [studentId], references: [id])
  studentId String?  @db.ObjectId
  course    Course   @relation(fields: [courseId], references: [id])
  courseId  String   @db.ObjectId
  progress  Float    @default(0)
  status    String   @default("active") // active | completed | dropped
  createdAt DateTime @default(now())
}

/// Results are entered per learning area, so an exam covering Maths and Science
/// is one assessment with two ExaminationSubject rows, not two assessments.
model ExaminationSubject {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  examination   Examination @relation(fields: [examinationId], references: [id], onDelete: Cascade)
  examinationId String      @db.ObjectId
  subject       Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId     String      @db.ObjectId

  @@unique([examinationId, subjectId])
  @@index([subjectId])
}

model StreamAllocation {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId String @db.ObjectId

  /// Allocations never leak across sessions — responsibility last year doesn't carry over.
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  academicYearId String       @db.ObjectId

  stream   Stream? @relation(fields: [streamId], references: [id], onDelete: Cascade)
  streamId String? @db.ObjectId

  class   Class?  @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId String? @db.ObjectId

  teacher   User   @relation("StreamAllocations", fields: [teacherId], references: [id])
  teacherId String @db.ObjectId

  responsibility StreamResponsibility

  /// Required for subject_teacher; absent for stream-team responsibilities.
  subject   Subject? @relation(fields: [subjectId], references: [id])
  subjectId String?  @db.ObjectId

  /// Whether an assistant may manage this stream (attendance, learners, comms). Main teacher always can.
  canManage Boolean @default(false)

  /// Allocation and marks entry are separate decisions — recorded separately.
  canEnterResults Boolean @default(true)

  status AllocationStatus @default(active)

  /// Preserved rather than overwritten so past responsibility is auditable after reassignment.
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([streamId, academicYearId])
  @@index([teacherId, academicYearId])
  @@index([schoolId, academicYearId])
  @@index([subjectId])
  @@index([responsibility, status])
}

model TeachingAssignment {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId String @db.ObjectId

  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId String  @db.ObjectId

  teacher   User   @relation("TeachingAssignments", fields: [teacherId], references: [id])
  teacherId String @db.ObjectId

  /// Allocation and entry rights are separate: a school can allocate without granting mark finalisation.
  canEnterResults Boolean       @default(true)
  academicYearId  String?       @db.ObjectId
  academicYear    AcademicYear? @relation(fields: [academicYearId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classId, subjectId, teacherId])
  @@index([teacherId])
  @@index([subjectId])
}

model Class {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId String @db.ObjectId

  name        String
  description String?

  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id])
  academicYearId String?       @db.ObjectId

  status ClassStatus @default(active)

  /// Home/primary learning area — separate from the teaching assignments for other areas.
  subject   Subject? @relation("SubjectClasses", fields: [subjectId], references: [id])
  subjectId String?  @db.ObjectId

  classCode           String?
  gradeLevel          String?
  teacher             User?                @relation("TeacherClasses", fields: [teacherId], references: [id])
  teacherId           String?              @db.ObjectId
  assistants          ClassAssistant[]
  courseId            String?              @db.ObjectId
  course              Course?              @relation(fields: [courseId], references: [id])
  enrollments         Enrollment[]
  assignments         Assignment[]         @relation("ClassAssignments")
  attendance          Attendance[]         @relation("ClassAttendance")
  schedules           ClassSchedule[]
  streams             Stream[]
  examinations        Examination[]        @relation("ClassExams")
  grades              Grade[]              @relation("ClassGrades")
  schedule            DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  teachingAssignments TeachingAssignment[]
  streamAllocations   StreamAllocation[]
  placementHistories  PlacementHistory[]

  /// Scoped to school — two schools can both have a "PP1" without conflict.
  @@unique([schoolId, classCode])
  @@index([schoolId])
}

model Enrollment {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  student   User?     @relation("StudentEnrollments", fields: [studentId], references: [id])
  studentId String?   @db.ObjectId
  class     Class     @relation(fields: [classId], references: [id])
  classId   String    @db.ObjectId
  /// Distinct from createdAt — allows archival imports to record a past enrolment date.
  startDate DateTime?

  createdAt DateTime @default(now())
  stream    Stream?  @relation(fields: [streamId], references: [id])
  streamId  String?  @db.ObjectId

  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id])
  academicYearId String?       @db.ObjectId

  notifications EnrollmentNotification[]

  @@unique([studentId, classId])
  @@index([academicYearId])
}

model ClassSchedule {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  class      Class     @relation(fields: [classId], references: [id])
  classId    String    @db.ObjectId
  dayOfWeek  Int       // 0=Sun..6=Sat
  startTime  String    // "HH:MM" 24h
  endTime    String    // "HH:MM" 24h
  room       String?
  recurrence String    @default("weekly") // weekly | biweekly | daily
  validFrom  DateTime
  validUntil DateTime?
  createdAt  DateTime  @default(now())
}

model Assignment {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  dueDate     DateTime
  class       Class?       @relation("ClassAssignments", fields: [classId], references: [id])
  classId     String?      @db.ObjectId
  unit        Unit?        @relation("UnitAssignments", fields: [unitId], references: [id])
  unitId      String?      @db.ObjectId
  rubric      String?
  maxScore    Float?
  submissions Submission[]
  grades      Grade[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Submission {
  id           String           @id @default(auto()) @map("_id") @db.ObjectId
  assignment   Assignment       @relation(fields: [assignmentId], references: [id])
  assignmentId String           @db.ObjectId
  student      User?            @relation("StudentSubmissions", fields: [studentId], references: [id])
  studentId    String?          @db.ObjectId
  content      String?
  fileUrl      String?
  score        Float?
  feedback     String?
  rubricScores Json?
  status       SubmissionStatus @default(pending)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model Examination {
  id             String               @id @default(auto()) @map("_id") @db.ObjectId
  title          String
  /// draft = hidden from learners; published = open; completed = marks locked.
  status         AssessmentStatus     @default(draft)
  /// Free text — permitted values come from SchoolAcademicSettings.assessmentTypes.
  assessmentType String?
  academicYearId String?              @db.ObjectId
  academicYear   AcademicYear?        @relation(fields: [academicYearId], references: [id])
  termId         String?              @db.ObjectId
  term           Term?                @relation(fields: [termId], references: [id])
  description    String?
  class          Class?               @relation("ClassExams", fields: [classId], references: [id])
  classId        String?              @db.ObjectId
  subject        Subject?             @relation("SubjectExams", fields: [subjectId], references: [id])
  subjectId      String?              @db.ObjectId
  startDate      DateTime
  endDate        DateTime?
  duration       Int?                 // minutes
  maxScore       Float?
  examAttempts   ExamAttempt[]
  grades         Grade[]              @relation("ExamGrades")
  learningAreas  ExaminationSubject[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([academicYearId])
  @@index([termId])
  @@index([status])
}

model ExamAttempt {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  examination   Examination @relation(fields: [examinationId], references: [id])
  examinationId String      @db.ObjectId
  student       User?       @relation("StudentExamAttempts", fields: [studentId], references: [id])
  studentId     String?     @db.ObjectId
  score         Float?
  graded        Boolean     @default(false)
  submittedAt   DateTime?
  createdAt     DateTime    @default(now())
}

/// restoredAt stamps a restore rather than deleting the row — both events are auditable.
/// restoredAt MUST be written as explicit null on create, never omitted:
/// MongoDB's $eq: null matches explicit null but not a missing key.
model LearnerExit {
  id        String            @id @default(auto()) @map("_id") @db.ObjectId
  student   StudentProfile    @relation(fields: [studentId], references: [id])
  studentId String            @db.ObjectId
  reason    LearnerExitReason
  exitDate  DateTime          @default(now())

  lastGradeLevel String?
  lastStream     String?

  academicYearId String?       @db.ObjectId
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id])

  destination String?
  notes       String?

  recordedBy   User?    @relation("ExitRecordedBy", fields: [recordedById], references: [id])
  recordedById String?  @db.ObjectId
  recordedAt   DateTime @default(now())

  restoredAt   DateTime?
  restoredBy   User?     @relation("ExitRestoredBy", fields: [restoredById], references: [id])
  restoredById String?   @db.ObjectId

  createdAt DateTime @default(now())

  @@index([reason])
  @@index([academicYearId])
  @@index([restoredAt])
}

/// Bounds of a CBC competency level as a share of max score (0-100). Configured per school.
model CompetencyBand {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  school      School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId    String          @db.ObjectId
  level       CompetencyLevel
  label       String
  /// Inclusive lower bound, 0-100.
  minPercent  Float
  /// Inclusive upper bound. Null on the top band (runs to 100).
  maxPercent  Float?
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  grades Grade[]

  @@unique([schoolId, level])
  @@index([schoolId])
}

/// Grading scale resolved from the learner's grade level. Versioned; only one
/// active at a time. Historical grades retain their scale reference.
model RacefieldScale {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  school        School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId      String    @db.ObjectId
  name          String
  description   String?
  gradeMin      Int
  gradeMax      Int
  version       Int       @default(1)
  isDefault     Boolean   @default(false)
  isActive      Boolean   @default(true)
  effectiveFrom DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  bands  RacefieldBand[]
  grades Grade[]

  @@unique([schoolId, gradeMin, version])
  @@index([schoolId])
  @@index([schoolId, gradeMin, isActive])
}

/// minScore/maxScore are on the normalised 0-100 score, not the raw mark, so a
/// 20-point paper is comparable to a 100-point one. code and points are stored
/// rather than derived so the platform never assumes a mapping the school may change.
model RacefieldBand {
  id        String         @id @default(auto()) @map("_id") @db.ObjectId
  scale     RacefieldScale @relation(fields: [scaleId], references: [id], onDelete: Cascade)
  scaleId   String         @db.ObjectId
  label     String
  code      String
  minScore  Float
  maxScore  Float
  points    Float?
  createdAt DateTime       @default(now())

  grades Grade[]

  @@index([scaleId])
  @@index([scaleId, minScore])
}

/// Subdivision of a class. Attendance, timetabling and assessment stay on the class;
/// the stream is a teaching-group split. Responsibility lives with the class team via StreamAllocation.
model Stream {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  class Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  classId  String       @db.ObjectId
  name     String
  code     String
  capacity Int?
  status   StreamStatus @default(active)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments        Enrollment[]
  allocations        StreamAllocation[]
  previousPlacements PlacementHistory[] @relation("PreviousPlacements")
  newPlacements      PlacementHistory[] @relation("NewPlacements")

  /// Copied from the parent class at creation so queries can filter without joining through Class.
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id])
  academicYearId String?       @db.ObjectId

  @@unique([classId, code])
  @@index([classId])
  @@index([status])
}

/// canManage is on the assignment, not inferred from a global role, so being a TEACHER
/// never implies authority over a class the teacher wasn't assigned to.
model ClassAssistant {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId String @db.ObjectId

  assistant   User   @relation("ClassAssistants", fields: [assistantId], references: [id])
  assistantId String @db.ObjectId

  canManage Boolean @default(true)

  createdAt DateTime @default(now())

  @@unique([classId, assistantId])
  @@index([assistantId])
}

/// Full audit of every learner stream move so "who was in Stream A on 3 March"
/// remains answerable after reorganisation.
model PlacementHistory {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  learnerId        String    @db.ObjectId
  previousStreamId String?   @db.ObjectId
  newStreamId      String?   @db.ObjectId
  classId          String    @db.ObjectId
  academicYearId   String    @db.ObjectId
  strategy         String    @default("manual")
  seed             Int?
  reason           String?
  actionById       String?   @db.ObjectId
  createdAt        DateTime  @default(now())

  learner        User?        @relation(fields: [learnerId], references: [id])
  previousStream Stream?      @relation("PreviousPlacements", fields: [previousStreamId], references: [id])
  newStream      Stream?      @relation("NewPlacements", fields: [newStreamId], references: [id])
  class          Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  actionBy       User?        @relation("PlacementActionBy", fields: [actionById], references: [id])

  @@index([classId, academicYearId])
  @@index([learnerId, createdAt])
  @@index([previousStreamId])
  @@index([newStreamId])
}

model Grade {
  id                String           @id @default(auto()) @map("_id") @db.ObjectId
  student           User?            @relation("StudentGrades", fields: [studentId], references: [id])
  studentId         String?          @db.ObjectId
  subject           Subject?         @relation("SubjectGrades", fields: [subjectId], references: [id])
  subjectId         String?          @db.ObjectId
  class             Class?           @relation("ClassGrades", fields: [classId], references: [id])
  classId           String?          @db.ObjectId
  exam              Examination?     @relation("ExamGrades", fields: [examinationId], references: [id])
  examinationId     String?          @db.ObjectId
  assignment        Assignment?      @relation(fields: [assignmentId], references: [id])
  assignmentId      String?          @db.ObjectId
  scale             GradeScale
  value             Float
  /// CBC level resolved against CompetencyBand at grading time.
  competencyLevel   CompetencyLevel?
  competencyBand    CompetencyBand?  @relation(fields: [competencyBandId], references: [id])
  competencyBandId  String?          @db.ObjectId
  racefieldScale    RacefieldScale?  @relation(fields: [racefieldScaleId], references: [id])
  racefieldScaleId  String?          @db.ObjectId
  /// Resolved from learner's grade level and the active Racefield scale.
  racefieldBand     RacefieldBand?   @relation(fields: [racefieldBandId], references: [id])
  racefieldBandId   String?          @db.ObjectId
  /// Denormalised at grading time — stays correct if the band code is later edited.
  racefieldBandCode String?
  /// Denormalised at grading time — historical results stay reproducible if points change.
  racefieldPoints   Float?
  comment           String?
  gradedAt          DateTime         @default(now())
  gradedBy          String?          @db.ObjectId
}

model LessonAccessLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  student    User?    @relation(fields: [studentId], references: [id])
  studentId  String?  @db.ObjectId
  lesson     Lesson?  @relation("LessonAccessLogs", fields: [lessonId], references: [id])
  lessonId   String?  @db.ObjectId
  accessedAt DateTime @default(now())
  durationMs Int      @default(0)
}

model Attendance {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  class       Class?           @relation("ClassAttendance", fields: [classId], references: [id])
  classId     String?          @db.ObjectId
  student     User?            @relation("StudentAttendance", fields: [studentId], references: [id])
  studentId   String?          @db.ObjectId
  status      AttendanceStatus @default(present)
  note        String?
  latitude    Float?
  longitude   Float?
  deviceId    String?
  ipAddress   String?
  date        DateTime
  markedAt    DateTime?
  submittedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([studentId])
  @@index([classId])
}

model CalendarEvent {
  id           String            @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  description  String?
  type         CalendarEventType @default(class_session)
  startDate    DateTime
  endDate      DateTime?
  allDay       Boolean           @default(false)
  classId      String?           @db.ObjectId
  assignmentId String?           @db.ObjectId
  createdBy    String            @db.ObjectId
  visibility   String            @default("personal") // personal | class | school
  color        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model Message {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  senderId     String?   @db.ObjectId
  recipientIds String[]
  subject      String?
  body         String
  readBy       String[]
  threadId     String?
  isDraft      Boolean   @default(false)
  sentAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([threadId])
}

model Notification {
  id        String               @id @default(auto()) @map("_id") @db.ObjectId
  user      User?                @relation(fields: [userId], references: [id])
  userId    String?              @db.ObjectId
  title     String
  body      String?
  channel   NotificationChannel  @default(in_app)
  priority  NotificationPriority @default(medium)
  read      Boolean              @default(false)
  readAt    DateTime?
  actionUrl String?
  createdAt DateTime             @default(now())

  @@index([userId])
}

model Document {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  description  String?
  fileUrl      String
  fileSize     Int?
  mimeType     String?
  category     String?
  uploadedById String?  @db.ObjectId
  visibility   String   @default("private") // private | shared | public
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// All currency stored as KSH / KES minor units (cents).

model FinanceAccount {
  id           String               @id @default(auto()) @map("_id") @db.ObjectId
  code         String               @unique
  name         String
  type         String               // asset | liability | income | expense | equity
  currency     String               @default("KES")
  createdAt    DateTime             @default(now())
  transactions FinanceTransaction[]
}

model FinanceTransaction {
  id          String                   @id @default(auto()) @map("_id") @db.ObjectId
  accountId   String                   @db.ObjectId
  account     FinanceAccount           @relation(fields: [accountId], references: [id])
  type        FinanceTransactionType
  status      FinanceTransactionStatus @default(draft)
  amountCents Int
  currency    String                   @default("KES")
  description String?
  reference   String?
  relatedId   String?                  // invoice/receipt/contract id
  postedAt    DateTime?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  receipts Receipt[] @relation("ReceiptTransaction")

  @@index([accountId])
  @@index([relatedId])
}

model Invoice {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  studentId   String?   @db.ObjectId
  student     User?     @relation("StudentInvoices", fields: [studentId], references: [id])
  number      String    @unique
  amountCents Int
  currency    String    @default("KES")
  status      String    @default("pending")
  issuedAt    DateTime  @default(now())
  dueDate     DateTime
  paidAt      DateTime?
  lineItems   Json?
  receipts    Receipt[] @relation("InvoiceReceipts")

  @@index([studentId])
}

model Receipt {
  id            String              @id @default(auto()) @map("_id") @db.ObjectId
  transactionId String?             @db.ObjectId
  transaction   FinanceTransaction? @relation("ReceiptTransaction", fields: [transactionId], references: [id])
  invoiceId     String?             @db.ObjectId
  invoice       Invoice?            @relation("InvoiceReceipts", fields: [invoiceId], references: [id])
  number        String              @unique
  amountCents   Int
  currency      String              @default("KES")
  method        String
  paidBy        String?             @db.ObjectId
  paidByName    String?
  receivedAt    DateTime            @default(now())

  @@index([transactionId])
  @@index([invoiceId])
}

model Expense {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  categoryId  String?          @db.ObjectId
  category    ExpenseCategory? @relation(fields: [categoryId], references: [id])
  amountCents Int
  currency    String           @default("KES")
  description String
  status      ExpenseStatus    @default(pending)
  paidAt      DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model ExpenseCategory {
  id       String    @id @default(auto()) @map("_id") @db.ObjectId
  name     String    @unique
  code     String?   @unique
  expenses Expense[]
}

model PayrollRun {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  periodStart DateTime
  periodEnd   DateTime
  status      PayrollStatus @default(pending)
  totalCents  Int
  currency    String        @default("KES")
  processedAt DateTime?
  createdAt   DateTime      @default(now())

  payslips Payslip[]
}

model Payslip {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  payrollRunId    String        @db.ObjectId
  payrollRun      PayrollRun    @relation(fields: [payrollRunId], references: [id])
  staffId         String        @db.ObjectId
  grossCents      Int
  deductionsCents Int
  netCents        Int
  currency        String        @default("KES")
  status          PayrollStatus @default(pending)
  createdAt       DateTime      @default(now())

  @@index([payrollRunId])
}

model TransportRoute {
  id          String                @id @default(auto()) @map("_id") @db.ObjectId
  code        String                @unique
  name        String
  startPoint  String
  endPoint    String
  stops       String[]
  fareCents   Int?
  currency    String                @default("KES")
  createdAt   DateTime              @default(now())
  assignments TransportAssignment[]
}

model TransportAssignment {
  id        String         @id @default(auto()) @map("_id") @db.ObjectId
  studentId String?        @db.ObjectId
  student   User?          @relation(fields: [studentId], references: [id])
  routeId   String         @db.ObjectId
  route     TransportRoute @relation(fields: [routeId], references: [id])

  @@index([studentId])
  @@index([routeId])
}

model LibraryBook {
  id              String             @id @default(auto()) @map("_id") @db.ObjectId
  isbn            String?            @unique
  title           String
  author          String?
  category        String?
  copiesTotal     Int                @default(1)
  copiesAvailable Int
  createdAt       DateTime           @default(now())
  borrowings      LibraryBorrowing[]
}

model LibraryBorrowing {
  id         String      @id @default(auto()) @map("_id") @db.ObjectId
  book       LibraryBook @relation(fields: [bookId], references: [id])
  bookId     String      @db.ObjectId
  studentId  String?     @db.ObjectId
  student    User?       @relation(fields: [studentId], references: [id])
  borrowedAt DateTime    @default(now())
  dueDate    DateTime
  returnedAt DateTime?

  @@index([bookId])
  @@index([studentId])
}

model Asset {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  tag                String?   @unique
  name               String
  category           String?
  purchasePriceCents Int?
  currency           String    @default("KES")
  purchaseDate       DateTime?
  status             String    @default("in_use") // in_use | in_repair | retired
  location           String?
  createdAt          DateTime  @default(now())
}

model AuditLog {
  id     String  @id @default(auto()) @map("_id") @db.ObjectId
  user   User?   @relation(fields: [userId], references: [id])
  userId String? @db.ObjectId

  /// schoolId scopes the log per institution. Without it, reading the log exposes
  /// every school's admin history. Resolved from actor's membership when not passed explicitly.
  school   School? @relation(fields: [schoolId], references: [id])
  schoolId String? @db.ObjectId

  action    String
  details   String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([schoolId])
  @@index([schoolId, createdAt])
}

model Invitation {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  email     String
  roleId    String?   @db.ObjectId
  role      Role?     @relation(fields: [roleId], references: [id])
  token     String    @unique
  status    String    @default("pending") // pending | accepted | expired
  invitedBy String?   @db.ObjectId
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

model EmailLog {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  to        String
  subject   String
  type      String
  status    String
  error     String?
  sentAt    DateTime?
  createdAt DateTime  @default(now())
}

model SystemSetting {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Multi-institution by design even if deployed for one school first — every
/// school-scoped record carries schoolId, so a second tenant is deployment work, not a rewrite.
model School {
  id                 String  @id @default(auto()) @map("_id") @db.ObjectId
  name               String
  displayName        String?
  registrationNumber String?
  schoolCode         String? @unique
  schoolType         String?
  schoolLevel        String?
  curriculum         String?
  yearEstablished    Int?
  motto              String?
  vision             String?
  mission            String?
  description        String?

  phone           String?
  email           String?
  altPhone        String?
  altEmail        String?
  website         String?
  admissionsEmail String?
  admissionsPhone String?
  financeEmail    String?
  financePhone    String?

  country         String?
  county          String?
  subCounty       String?
  town            String?
  postalAddress   String?
  postalCode      String?
  physicalAddress String?
  latitude        Float?
  longitude       Float?

  principalName  String?
  principalEmail String?
  principalPhone String?

  status    SchoolStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  memberships             SchoolMembership[]
  generalSettings         SchoolGeneralSettings?
  brandingSettings        SchoolBrandingSettings?
  academicSettings        SchoolAcademicSettings?
  financeSettings         SchoolFinanceSettings?
  subscriptionSettings    SchoolSubscriptionSettings?
  notificationSettings    SchoolNotificationSettings?
  securitySettings        SchoolSecuritySettings?
  glowSettings            SchoolGlowSettings?
  competencyBands         CompetencyBand[]
  racefieldScales         RacefieldScale[]
  academicYears           AcademicYear[]
  classes                 Class[]
  subjects                Subject[]
  streamAllocations       StreamAllocation[]
  enrollmentBatches       EnrollmentBatch[]
  courses                 Course[]
  auditLogs               AuditLog[]
  smsCampaigns            SmsCampaign[]
  smsOptOuts              SmsOptOut[]
  smsAutomationRules      SmsAutomationRule[]
  enrollmentNotifications EnrollmentNotification[]

  @@index([status])
}

enum SchoolStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

/// Authorises the scope of every school-scoped read and write.
model SchoolMembership {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @db.ObjectId
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId  String   @db.ObjectId
  isDefault Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([userId, schoolId])
  @@index([schoolId])
}

model SchoolGeneralSettings {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId String @unique @db.ObjectId

  name               String
  displayName        String?
  registrationNumber String?
  schoolCode         String?
  schoolType         String?
  schoolLevel        String?
  curriculum         String?
  yearEstablished    Int?
  motto              String?
  vision             String?
  mission            String?
  description        String?

  phone           String?
  email           String?
  altPhone        String?
  altEmail        String?
  website         String?
  admissionsEmail String?
  admissionsPhone String?
  financeEmail    String?
  financePhone    String?

  country         String?
  county          String?
  subCounty       String?
  town            String?
  postalAddress   String?
  postalCode      String?
  physicalAddress String?
  latitude        Float?
  longitude       Float?

  principalName  String?
  principalEmail String?
  principalPhone String?

  updatedAt DateTime @updatedAt
}

model SchoolBrandingSettings {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId String @unique @db.ObjectId

  logoUrl     String?
  logoAltText String?
  faviconUrl  String?

  /// Shown on the sign-in screen. Falls back to a branded panel when absent.
  coverImageUrl      String?
  coverImageAltText  String?
  primaryColor       String?
  secondaryColor     String?
  accentColor        String?
  portalNameOverride String?
  loginNameOverride  String?
  reportFooter       String?
  emailFooter        String?
  invoiceFooter      String?
  receiptFooter      String?
  applyToPortals     Boolean @default(true)
  applyToReports     Boolean @default(true)
  applyToEmail       Boolean @default(true)
  applyToFinance     Boolean @default(true)

  updatedAt DateTime @updatedAt
}

model SchoolAcademicSettings {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId String @unique @db.ObjectId

  currentAcademicYearId String?
  academicYearFormat    String?
  termsPerYear          Int     @default(3)
  weekStart             Int     @default(1)
  termStartDay          Int     @default(1)

  attendanceRequired     Boolean @default(true)
  attendanceGraceMinutes Int     @default(15)
  autoMarkAbsent         Boolean @default(false)
  allowLateArrival       Boolean @default(true)

  enableContinuousAssessment Boolean @default(false)
  endOfTermExamWeight        Int     @default(70)
  continuousAssessmentWeight Int     @default(30)
  minimumCompetencyLevel     String?

  gradingSystem      String?
  gradeScaleId       String?
  promotionRule      String?
  automaticPromotion Boolean @default(false)

  timetablePeriodsPerDay Int     @default(8)
  timetableStartTime     String?
  timetableEndTime       String?

  enableCompetencyFramework Boolean @default(false)
  competencyLevels          String? // JSON array
  assessmentTypes           String? // JSON array
  rubricEnabled             Boolean @default(false)
  portfoliosEnabled         Boolean @default(false)
  evidenceTrackingEnabled   Boolean @default(false)
  projectsEnabled           Boolean @default(false)

  updatedAt DateTime @updatedAt
}

model SchoolFinanceSettings {
