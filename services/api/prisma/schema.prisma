// ====================================================================
// FINANCE (all currency stored in KSH / KES minor units - cents)
// ====================================================================

model FinanceAccount {
  id           String               @id @default(auto()) @map("_id") @db.ObjectId
  code         String               @unique
  name         String
  type         String // asset | liability | income | expense | equity
  currency     String               @default("KES")
  createdAt    DateTime             @default(now())
  transactions FinanceTransaction[]
}

model FinanceTransaction {
  id          String                   @id @default(auto()) @map("_id") @db.ObjectId
  accountId   String                   @db.ObjectId
  account     FinanceAccount           @relation(fields: [accountId], references: [id])
  type        FinanceTransactionType
  status      FinanceTransactionStatus @default(draft)
  amountCents Int // stored in KSH minor units (cents)
  currency    String                   @default("KES")
  description String?
  reference   String?
  relatedId   String? // invoice/receipt/contract id
  postedAt    DateTime?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  receipts Receipt[] @relation("ReceiptTransaction")

  @@index([accountId])
  @@index([relatedId])
}

model Invoice {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  studentId   String?   @db.ObjectId
