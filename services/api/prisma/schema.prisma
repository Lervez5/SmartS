generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ====================================================================
// ENUMERATIONS
// ====================================================================

enum UserRole {
  SUPER_ADMIN
  ACCOUNTANT
  DEAN
  TEACHER
  PARENT
  STUDENT
}

enum UserStatus {
  pending
  active
  suspended
  archived
}

enum Gender {
  male
  female
  other
  unspecified
}

enum AdmissionStatus {
  pending
  accepted
  rejected
  withdrawn
  enrolled
}

/// What a teacher is allocated to do for one stream within one academic session.
///
/// These are responsibilities, not roles. A person can be a stream's main class
/// teacher and also teach a learning area to it, and the two allocations sit
/// side by side rather than one replacing the other.
enum StreamResponsibility {
  /// The single designated main/class teacher answerable for the stream.
  main_class_teacher
  /// Supports the main teacher, holding the rights the school grants on the
  /// assignment. Several may be active at once.
  assistant_class_teacher
  /// Teaches one learning area to the stream, alongside the stream team.
  subject_teacher
}

enum AllocationStatus {
  active
  inactive
}

enum AttendanceStatus {
  present
  absent
  late
  excused
  sick
  on_leave
}

enum CalendarEventType {
  class_session
  assignment_due
  quiz
  examination
  school_event
  holiday
  personal_reminder
  meeting
}

enum CourseStatus {
  draft
  published
  archived
}

enum SubmissionStatus {
  pending
  graded
}

enum GradeScale {
  letter
  percentage
  gpa
}

enum NotificationChannel {
  in_app
  email
  sms
}

enum NotificationPriority {
  low
  medium
  high
  urgent
}

enum FinanceTransactionType {
  invoice
  payment
  receipt
  refund
  credit
  debit
}

enum FinanceTransactionStatus {
  draft
  posted
  void
  cancelled
}

enum ExpenseStatus {
  pending
  approved
  paid
  cancelled
}

enum PayrollStatus {
  pending
  processed
  paid
  cancelled
}

enum StaffStatus {
  active
  on_leave
  terminated
  archived
}

// ====================================================================
// ROLES & PERMISSIONS (granular, permission-driven)
// ====================================================================

model Role {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  name            String           @unique
  description     String?
  rolePermissions RolePermission[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  roleMemberships UserRoleMembership[]
  invitations     Invitation[]
}

model Permission {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  key         String  @unique // e.g. "students.read", "attendance.write", "finance.invoice"
  name        String
  description String?
  domain      String // e.g. "students", "attendance", "finance"

  rolePermissions RolePermission[]
}

model RolePermission {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  roleId       String     @db.ObjectId
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])
  permissionId String     @db.ObjectId

  @@index([roleId])
  @@index([permissionId])
}

model UserRoleMembership {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @db.ObjectId
  role      Role     @relation(fields: [roleId], references: [id])
  roleId    String   @db.ObjectId
  createdAt DateTime @default(now())

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

// ====================================================================
// USERS & PEOPLE
// ====================================================================

model User {
  id                   String     @id @default(auto()) @map("_id") @db.ObjectId
  email                String     @unique
  firstName            String?
  lastName             String?
  name                 String?
  avatar               String?
  phone                String?
  status               UserStatus @default(pending)
  passwordHash         String?
  passwordResetToken   String?
  passwordResetExpires DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  sessionTokenVersion Int @default(0)

  roleMemberships   UserRoleMembership[]
  schoolMemberships SchoolMembership[]
  personalSettings  UserPersonalSettings?

  studentProfile StudentProfile?
  staffProfile   StaffProfile?
  parentProfile  ParentProfile?

  auditLogs     AuditLog[]
  exitsRecorded LearnerExit[]  @relation("ExitRecordedBy")
  exitsRestored LearnerExit[]  @relation("ExitRestoredBy")
  notifications Notification[]

  teacherClasses            Class[]               @relation("TeacherClasses")
  classAssistants           ClassAssistant[]      @relation("ClassAssistants")
  teachingAssignments       TeachingAssignment[]  @relation("TeachingAssignments")
  streamAllocations         StreamAllocation[]    @relation("StreamAllocations")
  teacherCourses            Course[]              @relation("TeacherCourses")
  enrollments               Enrollment[]          @relation("StudentEnrollments")
  courseEnrollments         CourseEnrollment[]    @relation("StudentCourseEnrollments")
  submissions               Submission[]          @relation("StudentSubmissions")
  examAttempts              ExamAttempt[]         @relation("StudentExamAttempts")
  grades                    Grade[]               @relation("StudentGrades")
  lessonAccessLogs          LessonAccessLog[]
  smsCampaignsCreated       SmsCampaign[]         @relation("SmsCampaignsCreated")
  smsAutomationRulesCreated SmsAutomationRule[]   @relation("SmsAutomationRulesCreated")
  attendance                Attendance[]          @relation("StudentAttendance")
  invoices                  Invoice[]             @relation("StudentInvoices")
  transportAssignments      TransportAssignment[]
  libraryBorrowings         LibraryBorrowing[]
}

model StudentProfile {
  id                   String                   @id @default(auto()) @map("_id") @db.ObjectId
  user                 User                     @relation(fields: [userId], references: [id])
  userId               String                   @unique @db.ObjectId
  admissionId          String?                  @db.ObjectId
  dateOfBirth          DateTime?
  gender               Gender?
  gradeLevel           String?
  enrollmentDate       DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  parentLinks          ParentChildLink[]
  admissionApplication AdmissionApplication?
  exits                LearnerExit[]
  smsRecipients        SmsRecipient[]
  notifications        EnrollmentNotification[]
}

model StaffProfile {
  id         String      @id @default(auto()) @map("_id") @db.ObjectId
  user       User        @relation(fields: [userId], references: [id])
  userId     String      @unique @db.ObjectId
  employeeId String?
  hireDate   DateTime?
  position   String?
  department String?
  status     StaffStatus @default(active)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model ParentProfile {
  id            String                   @id @default(auto()) @map("_id") @db.ObjectId
  user          User                     @relation(fields: [userId], references: [id])
  userId        String                   @unique @db.ObjectId
  children      ParentChildLink[]
  smsRecipients SmsRecipient[]
  smsOptOut     SmsOptOut?
  notifications EnrollmentNotification[]
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
}

model ParentChildLink {
  id        String         @id @default(auto()) @map("_id") @db.ObjectId
  parentId  String         @db.ObjectId
  parent    ParentProfile  @relation(fields: [parentId], references: [id])
  childId   String         @db.ObjectId
  child     StudentProfile @relation(fields: [childId], references: [id])
  createdAt DateTime       @default(now())

  @@unique([parentId, childId])
}

// ====================================================================
// ADMISSIONS
// ====================================================================

model AdmissionApplication {
  id          String              @id @default(auto()) @map("_id") @db.ObjectId
  applicantId String              @unique @db.ObjectId
  applicant   StudentProfile      @relation(fields: [applicantId], references: [id])
  status      AdmissionStatus     @default(pending)
  appliedAt   DateTime            @default(now())
  reviewedAt  DateTime?
  reviewedBy  String?             @db.ObjectId
  notes       String?
  documents   AdmissionDocument[]
}

model AdmissionDocument {
  id            String               @id @default(auto()) @map("_id") @db.ObjectId
  application   AdmissionApplication @relation(fields: [applicationId], references: [id])
  applicationId String               @db.ObjectId
  name          String
  fileUrl       String?
  uploadedAt    DateTime             @default(now())
}

// ====================================================================
// ENROLLMENT HUB — bulk onboarding of any person category
// ====================================================================

/// How a bulk enrollment run is going, in the terms an operator waits for.
enum EnrollmentBatchStatus {
  /// Accepted, work not finished — a partial import has been recorded.
  draft
  /// Every row has been decided.
  completed
  /// Abandoned before the rows were decided.
  abandoned
}

/// What happened to one row of a bulk enrollment.
///
/// `duplicate` is deliberately separate from `failed`: a row whose email is
/// already in the school is not an error, it is a decision the school has to
/// make (skip, or attach the existing account), so it must be reported apart
/// from rows that could not be understood at all.
enum EnrollmentEntryStatus {
  /// Not yet onboarded: no account and no profile created for this row.
  pending
  /// Account and profile created, and for learners placed in a class.
  enrolled
  /// Already existed in the school; nothing was created.
  duplicate
  /// Could not be onboarded; the reason is on the row.
  failed
}

/// One onboarding run. The batch is the audit unit.
model EnrollmentBatch {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  /// The school these people are joining. Never inferred from the rows.
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId String @db.ObjectId

  status EnrollmentBatchStatus @default(draft)

  /// Where the rows came from.
  source String?
  notes  String?

  totalRows      Int @default(0)
  enrolledCount  Int @default(0)
  duplicateCount Int @default(0)
  failedCount    Int @default(0)

  /// Who ran the onboarding. A plain reference, like AdmissionApplication.reviewedBy:
  /// deleting a staff account must not delete the record that they onboarded
  /// everyone.
  createdById String? @db.ObjectId

  entries   EnrollmentBatchEntry[]
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  @@index([schoolId])
  @@index([schoolId, createdAt])
}

/// One person in an onboarding run, with role-specific attributes per row.
model EnrollmentBatchEntry {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  batch   EnrollmentBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  batchId String          @db.ObjectId

  /// Position in the source, so a bad row can be traced back to the file or
  /// paste it came from.
  rowNumber Int

  /// The role this person is brought in as. Decides which profile is created:
  /// STUDENT gets a StudentProfile, PARENT a ParentProfile, and every staff
  /// role a StaffProfile.
  role UserRole @default(STUDENT)

  status EnrollmentEntryStatus @default(pending)

  /// Identity. Email is the join key: an existing account is what makes a row
  /// a duplicate rather than a new person.
  email     String
  firstName String?
  lastName  String?
  phone     String?

  gradeLevel      String?
  dateOfBirth     DateTime?
  gender          Gender?
  admissionNumber String?
  /// Placement for a learner. Validated to belong to the caller's school, and
  /// the stream to belong to the class, before anything is written.
  classId         String?   @db.ObjectId
  streamId        String?   @db.ObjectId
  academicYearId  String?   @db.ObjectId
  /// Guardian to link a learner to, matched by email rather than by id, because
  /// that is what an operator has when pasting a roster.
  parentEmail     String?

  employeeId String?
  position   String?
  department String?
  hireDate   DateTime?

  /// The account this row produced.
  userId String? @db.ObjectId
  /// Why the row could not be onboarded, or why it was skipped.
  error  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([batchId])
  @@index([batchId, status])
  @@index([batchId, email])
}

// ====================================================================
// ACADEMICS
// ====================================================================

model Subject {
  id                  String               @id @default(auto()) @map("_id") @db.ObjectId
  name                String
  code                String?
  description         String?
  topics              Topic[]
  lessons             Lesson[]
  classes             Class[]              @relation("SubjectClasses")
  courses             Course[]
  examinations        Examination[]        @relation("SubjectExams")
  grades              Grade[]              @relation("SubjectGrades")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  school              School               @relation(fields: [schoolId], references: [id])
  schoolId            String               @db.ObjectId
  examinationSubjects ExaminationSubject[]
  teachingAssignments TeachingAssignment[]
  streamAllocations   StreamAllocation[]
  gradeLevels         SubjectGradeLevel[]

  /// Lifecycle state, following the same shape as ClassStatus and StreamStatus
  /// so the academic domain reads consistently.
  ///
  /// `inactive` and `archived` are the safe way to retire a learning area: the
  /// record and everything attached to it stays readable, while it stops
  /// appearing as a choice for new assessments, allocations and results.
  status LearningAreaStatus @default(active)

  /// Where this learning area came from, which decides what the school may do
  /// to it. See the enum.
  origin LearningAreaOrigin @default(custom)

  /// Which grades the area is offered to. `all` is an explicit decision that the
  /// area is taught in every grade the school runs; `selected` restricts it to
  /// the grades listed in `gradeLevels`.
  gradeScope GradeScope @default(all)

  @@unique([schoolId, name])
  @@unique([schoolId, code])
  @@index([schoolId, status])
  @@index([schoolId, origin])
}

/// Only present when the area's `gradeScope` is `selected`. The grade level is
/// the school's own vocabulary from `Class.gradeLevel`, never hardcoded.
/// Deliberately separate from `Class.subjectId`, which is a class's *home*
/// learning area and must not be repurposed as a grade filter.
model SubjectGradeLevel {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId String  @db.ObjectId

  gradeLevel String
  createdAt  DateTime @default(now())

  @@unique([subjectId, gradeLevel])
  @@index([gradeLevel])
}

model Topic {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  subject   Subject  @relation(fields: [subjectId], references: [id])
  subjectId String   @db.ObjectId
  lessons   Lesson[]
}

model Lesson {
  id         String            @id @default(auto()) @map("_id") @db.ObjectId
  title      String
  subject    Subject?          @relation(fields: [subjectId], references: [id])
  subjectId  String?           @db.ObjectId
  topic      Topic?            @relation(fields: [topicId], references: [id])
  topicId    String?           @db.ObjectId
  unit       Unit?             @relation(fields: [unitId], references: [id])
  unitId     String?           @db.ObjectId
  lessonType String            @default("note") // video | pdf | note | interactive
  content    String?
  fileUrl    String?
  duration   Int? // in seconds
  difficulty Float? // 0..1
  exercises  Exercise[]
  accessLogs LessonAccessLog[] @relation("LessonAccessLogs")
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
}

model Exercise {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  lesson     Lesson?  @relation(fields: [lessonId], references: [id])
  lessonId   String?  @db.ObjectId
  prompt     String
  maxScore   Float
  difficulty Float?
  createdAt  DateTime @default(now())
}

// ====================================================================
// ACADEMIC SESSIONS
//
// An AcademicYear is the school's academic session (2026, 2026/27). A Term is
// an individual academic period inside a session, so the two are kept
// distinct rather than collapsed into one record.
//
// The session is the unit that other domains are measured against: invoices and
// receipts are counted within a session's dates, and learner enrolments are
// attributed to the session they joined in. That makes the session the shared
// context the admin navbar resolves and the other modules read.
// ====================================================================

enum AcademicSessionStatus {
  planned
  active
  completed
  archived
}

enum TermStatus {
  planned
  active
  completed
}

enum LearnerExitReason {
  completed
  transferred
  withdrawn
}

/// The Kenyan CBC performance levels.
///
/// These are the four levels the curriculum defines, ordered from strongest.
/// The boundaries between them are school configuration, not a constant: see
/// CompetencyBand.
enum CompetencyLevel {
  /// Exceeds Expectation
  EE
  /// Meets Expectation
  ME
  /// Approaches Expectation
  AE
  /// Below Expectation
  BE
}

enum StreamStatus {
  active
  inactive
  archived
}

/// Lifecycle state of a Class/Grade record.
///
/// `active` classes accept new streams and learners. `inactive` classes are
/// retained but closed to new streams. `archived` classes are historical: their
/// structure, enrolments and results remain readable but no new learners or
/// streams may be added.
enum ClassStatus {
  active
  inactive
  archived
}

/// Where a learning area came from, which decides what a school may do to it.
///
/// `custom` is defined by the school itself, and is the school's to name,
/// restrict and retire. `curriculum` is a record that arrived from the
/// authoritative curriculum source through synchronization, and is the
/// curriculum's to change — editing or deleting it here would silently diverge
/// from the official curriculum.
///
/// Nothing is created as `curriculum` until a real synchronization source
/// exists. Areas a school has always maintained are `custom`, because that is
/// what they are.
enum LearningAreaOrigin {
  custom
  curriculum
}

/// Shaped like ClassStatus and StreamStatus. Retiring rather than deleting is
/// the point: assessments, results and allocations reference a learning area by
/// id, so deleting one would take the meaning of those records with it.
enum LearningAreaStatus {
  active
  inactive
  archived
}

  /// `all` is an explicit choice, not the absence of one - which is what stops an empty grade list reading as both "taught everywhere" and "not configured yet".
enum GradeScope {
  all
  selected
}

enum AssessmentStatus {
  draft
  published
  completed
  archived
}

model AcademicYear {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  /// The school this session belongs to. An academic session is
  /// per-institution: without its own scope, every school's "current session"
  /// would resolve to whichever record happened to be written last.
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId String @db.ObjectId

  /// Unique per school rather than globally, since two schools both running a
  /// "2026" session is normal and one must not block the other.
  name                String // e.g. 2026
  label               String? // display label, e.g. "2026 Academic Session"
  startDate           DateTime
  endDate             DateTime
  /// Only one session is `active` at a time; the service enforces it.
  status              AcademicSessionStatus @default(planned)
  terms               Term[]
  examinations        Examination[]
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  learnerExits        LearnerExit[]
  teachingAssignments TeachingAssignment[]
  streamAllocations   StreamAllocation[]
  classes             Class[]
  streams             Stream[]
  enrollments         Enrollment[]

  @@unique([schoolId, name])
  @@index([status])
  @@index([schoolId])
}

model Term {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  academicYearId String        @db.ObjectId
  academicYear   AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  name           String // e.g. "Term 1"
  termNumber     Int
  startDate      DateTime
  endDate        DateTime
  status         TermStatus    @default(planned)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  examinations   Examination[]

  @@unique([academicYearId, termNumber])
  @@index([status])
}

model Course {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  /// The school that runs this course.
  ///
  /// A course belongs to one school, the same as the class, subject and
  /// allocation records it connects to. It was missing, which left every
  /// course query unscoped and let one school read another's courses: the
  /// school could only be inferred transitively through the course's subject or
  /// classes, and a course with neither would have belonged to no school at all
  /// while still being listed everywhere.
  school             School?            @relation(fields: [schoolId], references: [id])
  schoolId           String?            @db.ObjectId
  title              String
  description        String?
  code               String?            @unique
  category           String?
  status             CourseStatus       @default(draft)
  learningObjectives String[]
  teacher            User?              @relation("TeacherCourses", fields: [teacherId], references: [id])
  teacherId          String?            @db.ObjectId
  subject            Subject?           @relation(fields: [subjectId], references: [id])
  subjectId          String?            @db.ObjectId
  modules            Module[]
  enrollments        CourseEnrollment[]
  classes            Class[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([schoolId])
  @@index([schoolId, status])
}

model Module {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  order       Int
  course      Course   @relation(fields: [courseId], references: [id])
  courseId    String   @db.ObjectId
  units       Unit[]
  createdAt   DateTime @default(now())
}

model Unit {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  order       Int
  module      Module?      @relation(fields: [moduleId], references: [id])
  moduleId    String?      @db.ObjectId
  lessons     Lesson[]
  assignments Assignment[] @relation("UnitAssignments")
  createdAt   DateTime     @default(now())
}

model CourseEnrollment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  student   User?    @relation("StudentCourseEnrollments", fields: [studentId], references: [id])
  studentId String?  @db.ObjectId
  course    Course   @relation(fields: [courseId], references: [id])
  courseId  String   @db.ObjectId
  progress  Float    @default(0)
  status    String   @default("active") // active | completed | dropped
  createdAt DateTime @default(now())
}

// ====================================================================
// CLASSES, ENROLLMENTS, SCHEDULE
// ====================================================================

/// The learning areas a summative assessment covers.
///
/// Results are entered per learning area, so the applicable areas are a property
/// of the assessment rather than a single subject: a paper that assesses
/// Mathematics and Science is one assessment with two areas, not two
/// assessments.
model ExaminationSubject {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  examination   Examination @relation(fields: [examinationId], references: [id], onDelete: Cascade)
  examinationId String      @db.ObjectId
  subject       Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId     String      @db.ObjectId

  @@unique([examinationId, subjectId])
  @@index([subjectId])
}

/// The authoritative teaching allocation: which teacher is responsible for
/// which learning area in which stream. Each stream carries its own team, so
/// they cannot disagree about who is answerable.
model StreamAllocation {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId String @db.ObjectId

  /// The session the allocation belongs to. Allocations never leak across
  /// sessions: being responsible for a stream last year does not make a teacher
  /// responsible for it this year unless the school recorded it again.
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  academicYearId String       @db.ObjectId

  stream   Stream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  streamId String @db.ObjectId

  teacher   User   @relation("StreamAllocations", fields: [teacherId], references: [id])
  teacherId String @db.ObjectId

  responsibility StreamResponsibility

  /// Required for `subject_teacher` and absent for the stream team, which covers
  /// the stream as a whole rather than one learning area.
  subject   Subject? @relation(fields: [subjectId], references: [id])
  subjectId String?  @db.ObjectId

  /// Whether an assistant may manage this stream - attendance, learners, class
  /// communication - or may only view it. The main teacher always may.
  canManage Boolean @default(false)

  /// Whether this teacher may enter results for the pairing. Being allocated to
  /// teach a learning area and being allowed to finalise its marks are separate
  /// decisions, so they are recorded separately.
  canEnterResults Boolean @default(true)

  status AllocationStatus @default(active)

  /// Effective period, preserved rather than overwritten, so who was responsible
  /// for a stream on a given date stays answerable after a reassignment.
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([streamId, academicYearId])
  @@index([teacherId, academicYearId])
  @@index([schoolId, academicYearId])
  @@index([subjectId])
  @@index([responsibility, status])
}

model TeachingAssignment {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId String @db.ObjectId

  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId String  @db.ObjectId

  teacher   User   @relation("TeachingAssignments", fields: [teacherId], references: [id])
  teacherId String @db.ObjectId

  /// Whether this teacher may enter results for the pairing. Allocation and
  /// entry rights are separate: a school can allocate a teacher to a class for a
  /// term without letting them finalise marks.
  canEnterResults Boolean       @default(true)
  /// The session the allocation applies to, when it is term-specific.
  academicYearId  String?       @db.ObjectId
  academicYear    AcademicYear? @relation(fields: [academicYearId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classId, subjectId, teacherId])
  @@index([teacherId])
  @@index([subjectId])
}

model Class {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  /// A class belongs to one school. This is also what makes the class teacher
  /// and the assistant class teacher meaningful: they are staff of this school
  /// teaching this class.
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId String @db.ObjectId

  name        String
  description String?

  /// The academic session this class/grade belongs to. A class is always
  /// created within a specific session so that streams and learners attached
  /// to it are correctly attributed.
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id])
  academicYearId String?       @db.ObjectId

  /// Lifecycle state. Archived classes are read-only for new learners and streams.
  status ClassStatus @default(active)

  /// The class's primary or home learning area. A class offers several learning
  /// areas, each taught by an assigned teacher (see TeachingAssignment). This is the
  /// single area a class is named/timetabled against.
  subject   Subject? @relation("SubjectClasses", fields: [subjectId], references: [id])
  subjectId String?  @db.ObjectId

  classCode           String?
  gradeLevel          String?
  teacher             User?                @relation("TeacherClasses", fields: [teacherId], references: [id])
  teacherId           String?              @db.ObjectId
  assistants          ClassAssistant[]
  courseId            String?              @db.ObjectId
  course              Course?              @relation(fields: [courseId], references: [id])
  enrollments         Enrollment[]
  assignments         Assignment[]         @relation("ClassAssignments")
  attendance          Attendance[]         @relation("ClassAttendance")
  schedules           ClassSchedule[]
  streams             Stream[]
  examinations        Examination[]        @relation("ClassExams")
  grades              Grade[]              @relation("ClassGrades")
  schedule            DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  teachingAssignments TeachingAssignment[]

  /// Scoped to the school: one school taking PP1 must not stop another
  /// school from having a PP1. Nothing looks a class up by code alone.
  @@unique([schoolId, classCode])
  @@index([schoolId])
}

model Enrollment {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  student   User?     @relation("StudentEnrollments", fields: [studentId], references: [id])
  studentId String?   @db.ObjectId
  class     Class     @relation(fields: [classId], references: [id])
  classId   String    @db.ObjectId
  /// When the learner joined this class. Distinct from `createdAt` so an
  /// archival or data-migration import can record a past enrolment date rather
  /// than the row-creation timestamp.
  startDate DateTime?

  createdAt DateTime @default(now())
  stream    Stream?  @relation(fields: [streamId], references: [id])
  streamId  String?  @db.ObjectId

  /// The academic session the enrolment belongs to, so the lifecycle timeline
  /// can attribute each class placement to the session the learner joined it in.
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id])
  academicYearId String?       @db.ObjectId

  notifications EnrollmentNotification[]

  @@unique([studentId, classId])
  @@index([academicYearId])
}

model ClassSchedule {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  class      Class     @relation(fields: [classId], references: [id])
  classId    String    @db.ObjectId
  dayOfWeek  Int // 0=Sun .. 6=Sat
  startTime  String // "HH:MM" 24h
  endTime    String // "HH:MM" 24h
  room       String?
  recurrence String    @default("weekly") // weekly | biweekly | daily
  validFrom  DateTime
  validUntil DateTime?
  createdAt  DateTime  @default(now())
}

// ====================================================================
// ASSIGNMENTS, SUBMISSIONS, EXAMINATIONS, GRADING & LMS
// ====================================================================

model Assignment {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  dueDate     DateTime
  class       Class?       @relation("ClassAssignments", fields: [classId], references: [id])
  classId     String?      @db.ObjectId
  unit        Unit?        @relation("UnitAssignments", fields: [unitId], references: [id])
  unitId      String?      @db.ObjectId
  rubric      String?
  maxScore    Float?
  submissions Submission[]
  grades      Grade[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Submission {
  id           String           @id @default(auto()) @map("_id") @db.ObjectId
  assignment   Assignment       @relation(fields: [assignmentId], references: [id])
  assignmentId String           @db.ObjectId
  student      User?            @relation("StudentSubmissions", fields: [studentId], references: [id])
  studentId    String?          @db.ObjectId
  content      String?
  fileUrl      String?
  score        Float?
  feedback     String?
  rubricScores Json?
  status       SubmissionStatus @default(pending)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model Examination {
  id             String               @id @default(auto()) @map("_id") @db.ObjectId
  title          String
  /// Lifecycle state. `draft` is not visible to learners; `published` opens the
  /// assessment; `completed` locks marks entry.
  status         AssessmentStatus     @default(draft)
  /// Free text rather than an enum because the permitted values are school
  /// policy: SchoolAcademicSettings.assessmentTypes lists what the school uses.
  assessmentType String?
  /// The authoritative academic context, so a summative assessment belongs to
  /// the same session and term the navbar selects rather than to loose dates.
  academicYearId String?              @db.ObjectId
  academicYear   AcademicYear?        @relation(fields: [academicYearId], references: [id])
  termId         String?              @db.ObjectId
  term           Term?                @relation(fields: [termId], references: [id])
  description    String?
  class          Class?               @relation("ClassExams", fields: [classId], references: [id])
  classId        String?              @db.ObjectId
  /// Subject is the learning-area analogue the platform currently carries.
  subject        Subject?             @relation("SubjectExams", fields: [subjectId], references: [id])
  subjectId      String?              @db.ObjectId
  startDate      DateTime
  endDate        DateTime?
  duration       Int? // minutes
  maxScore       Float?
  examAttempts   ExamAttempt[]
  grades         Grade[]              @relation("ExamGrades")
  learningAreas  ExaminationSubject[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([academicYearId])
  @@index([termId])
  @@index([status])
}

model ExamAttempt {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  examination   Examination @relation(fields: [examinationId], references: [id])
  examinationId String      @db.ObjectId
  student       User?       @relation("StudentExamAttempts", fields: [studentId], references: [id])
  studentId     String?     @db.ObjectId
  score         Float?
  graded        Boolean     @default(false)
  submittedAt   DateTime?
  createdAt     DateTime    @default(now())
}

/// A record that a learner has left the school.
/// Kept on StudentProfile so the learner keeps one identity. Restore stamps
/// restoredAt rather than deleting, so both are auditable.
model LearnerExit {
  id        String            @id @default(auto()) @map("_id") @db.ObjectId
  student   StudentProfile    @relation(fields: [studentId], references: [id])
  studentId String            @db.ObjectId
  reason    LearnerExitReason
  exitDate  DateTime          @default(now())

  /// Level and stream the learner was in when they left. Stream is free text
  /// because the schema has no Stream model; it is null when none was assigned.
  lastGradeLevel String?
  lastStream     String?

  /// The academic session the exit falls in, so the archive is scoped the same
  /// way every other academic record is.
  academicYearId String?       @db.ObjectId
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id])

  /// Where they went, for a transfer.
  destination String?
  notes       String?

  recordedBy   User?    @relation("ExitRecordedBy", fields: [recordedById], references: [id])
  recordedById String?  @db.ObjectId
  recordedAt   DateTime @default(now())

  /// Set when the learner is re-enrolled. Must be written explicitly as null on
  /// create, not omitted: MongoDB's `$eq: null` matches an explicit null but
  /// not a missing key, so an omitted field would make the unresolved-exit
  /// filter return empty.
  restoredAt   DateTime?
  restoredBy   User?     @relation("ExitRestoredBy", fields: [restoredById], references: [id])
  restoredById String?   @db.ObjectId

  createdAt DateTime @default(now())

  @@index([reason])
  @@index([academicYearId])
  @@index([restoredAt])
}

/// Bounds of a CBC competency level, as a share of the assessment's max score.
/// Configured per school; ordered by `minPercent`.
model CompetencyBand {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  school      School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId    String          @db.ObjectId
  level       CompetencyLevel
  /// Human label, so the interface never has to expand the enum.
  label       String
  /// Inclusive lower bound, 0-100. Bands are matched on the learner's score as a
  /// percentage of the assessment maximum.
  minPercent  Float
  /// Inclusive upper bound. Null on the highest band, which runs to 100.
  maxPercent  Float?
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  grades Grade[]

  @@unique([schoolId, level])
  @@index([schoolId])
}

/// The school's grading standard, resolved from the learner's grade level.
/// Versioned per grade range; only one active at a time. Historical grades
/// retain their scale reference for reproducibility.
model RacefieldScale {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  school        School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId      String    @db.ObjectId
  name          String
  description   String?
  gradeMin      Int
  gradeMax      Int
  version       Int       @default(1)
  isDefault     Boolean   @default(false)
  isActive      Boolean   @default(true)
  effectiveFrom DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  bands  RacefieldBand[]
  grades Grade[]

  @@unique([schoolId, gradeMin, version])
  @@index([schoolId])
  @@index([schoolId, gradeMin, isActive])
}

/// One band within a Racefield scale.
///
/// `minScore` and `maxScore` are the inclusive boundaries on the normalised
/// 0-100 score, not on the raw mark. A 20-point paper is therefore comparable
/// to a 100-point one.
///
/// `code` is the short grade code the school configures (e.g. EE, ME, AE, BE,
/// EE1, BE2). It is stored rather than derived so the platform never assumes
/// a mapping that the school might change. `points` is the numeric value the
/// school assigns to the band for aggregation purposes.
model RacefieldBand {
  id        String         @id @default(auto()) @map("_id") @db.ObjectId
  scale     RacefieldScale @relation(fields: [scaleId], references: [id], onDelete: Cascade)
  scaleId   String         @db.ObjectId
  label     String
  code      String
  minScore  Float
  maxScore  Float
  points    Float?
  createdAt DateTime       @default(now())

  grades Grade[]

  @@index([scaleId])
  @@index([scaleId, minScore])
}

/// A subdivision of a class. Attendance, timetabling and assessment stay
/// anchored to the class; the stream is how a class splits into teaching groups.
/// It carries no teacher of its own — responsibility lives with the class's
/// team, not on the stream.
model Stream {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  class Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  /// Unique within the class.
  classId  String       @db.ObjectId
  name     String
  code     String
  capacity Int?
  status   StreamStatus @default(active)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments    Enrollment[]
  /// The teaching team and learning-area teachers for this stream.
  allocations    StreamAllocation[]
  /// Scoped academic session, copied from the parent class at creation. This
  /// keeps the session explicit on the stream so queries can filter without
  /// joining through the class, and so the hierarchy invariant is enforced at
  /// the data layer.
  academicYear   AcademicYear?      @relation(fields: [academicYearId], references: [id])
  academicYearId String?            @db.ObjectId

  @@unique([classId, code])
  @@index([classId])
  @@index([status])
}

/// An assistant class teacher, with the rights that assignment grants.
///
/// `canManage` is what lets a school give an assistant the same operational
/// rights as the main class teacher, or fewer. It is recorded on the assignment
/// rather than inferred from a global role, so being a TEACHER never implies
/// authority over a class one was not assigned to.
model ClassAssistant {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId String @db.ObjectId

  assistant   User   @relation("ClassAssistants", fields: [assistantId], references: [id])
  assistantId String @db.ObjectId

  canManage Boolean @default(true)

  createdAt DateTime @default(now())

  @@unique([classId, assistantId])
  @@index([assistantId])
}

model Grade {
  id                String           @id @default(auto()) @map("_id") @db.ObjectId
  student           User?            @relation("StudentGrades", fields: [studentId], references: [id])
  studentId         String?          @db.ObjectId
  subject           Subject?         @relation("SubjectGrades", fields: [subjectId], references: [id])
  subjectId         String?          @db.ObjectId
  class             Class?           @relation("ClassGrades", fields: [classId], references: [id])
  classId           String?          @db.ObjectId
  exam              Examination?     @relation("ExamGrades", fields: [examinationId], references: [id])
  examinationId     String?          @db.ObjectId
  assignment        Assignment?      @relation(fields: [assignmentId], references: [id])
  assignmentId      String?          @db.ObjectId
  scale             GradeScale
  value             Float
  /// The CBC competency level this score falls into, resolved against the
  /// school's CompetencyBand boundaries when the grade was recorded.
  competencyLevel   CompetencyLevel?
  competencyBand    CompetencyBand?  @relation(fields: [competencyBandId], references: [id])
  competencyBandId  String?          @db.ObjectId
  /// The Racefield grading scale applied when the grade was recorded.
  racefieldScale    RacefieldScale?  @relation(fields: [racefieldScaleId], references: [id])
  racefieldScaleId  String?          @db.ObjectId
  /// The Racefield band this score falls into, resolved from the learner's
  /// grade level and the active Racefield scale.
  racefieldBand     RacefieldBand?   @relation(fields: [racefieldBandId], references: [id])
  racefieldBandId   String?          @db.ObjectId
  /// Denormalised band code, captured from the band at grading time so the
  /// result stays readable even if the band's code is later edited.
  racefieldBandCode String?
  /// Denormalised numeric points assigned to the band at grading time, so
  /// historical results remain reproducible if points are later changed.
  racefieldPoints   Float?
  comment           String?
  gradedAt          DateTime         @default(now())
  gradedBy          String?          @db.ObjectId
}

model LessonAccessLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  student    User?    @relation(fields: [studentId], references: [id])
  studentId  String?  @db.ObjectId
  lesson     Lesson?  @relation("LessonAccessLogs", fields: [lessonId], references: [id])
  lessonId   String?  @db.ObjectId
  accessedAt DateTime @default(now())
  durationMs Int      @default(0)
}

// ====================================================================
// ATTENDANCE
// ====================================================================

model Attendance {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  class       Class?           @relation("ClassAttendance", fields: [classId], references: [id])
  classId     String?          @db.ObjectId
  student     User?            @relation("StudentAttendance", fields: [studentId], references: [id])
  studentId   String?          @db.ObjectId
  status      AttendanceStatus @default(present)
  note        String?
  latitude    Float?
  longitude   Float?
  deviceId    String?
  ipAddress   String?
  date        DateTime
  markedAt    DateTime?
  submittedAt DateTime?
