{
  "name": "school-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "School OS - a one-school School Operating System (Turborepo + pnpm monorepo).",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "pnpm --filter school-os-api dev",
    "dev:admin": "pnpm --filter school-os-admin dev",
    "dev:student": "pnpm --filter school-os-student dev",
    "dev:teacher": "pnpm --filter school-os-teacher dev",
    "dev:parent": "pnpm --filter school-os-parent dev",
    "build": "turbo run build --concurrency=2",
    "build:admin": "pnpm --filter school-os-admin build",
    "build:student": "pnpm --filter school-os-student build",
    "build:teacher": "pnpm --filter school-os-teacher build",
    "build:parent": "pnpm --filter school-os-parent build",
    "build:api": "pnpm --filter school-os-api build",
    "clean": "node scripts/clean.mjs",
    "start": "turbo run start",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:auth": "pnpm --filter school-os-api run test:auth",
    "test:watch": "pnpm --filter school-os-api exec vitest watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed": "pnpm --filter school-os-api run seed",
    "gen:gap-pages": "tsx scripts/generate-gap-pages.ts",
    "db:push": "node scripts/prisma.mjs push",
    "db:generate": "node scripts/prisma.mjs generate",
    "db:validate": "node scripts/prisma.mjs validate",
    "db:format": "node scripts/prisma.mjs format",
    "db:check": "node scripts/prisma.mjs check",
    "db:indexes": "pnpm --filter school-os-api run db:indexes",
    "verify": "pnpm run db:check && pnpm run format:check && pnpm run lint && pnpm run typecheck",
    "postinstall": "node scripts/prisma.mjs generate || echo 'prisma generate skipped - run pnpm db:generate once the database env is available'",
    "prepare": "husky",
    "commitlint": "commitlint"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.14.0",
    "@types/node": "^22.19.0",
    "autoprefixer": "^10.6.1",
    "clsx": "^2.1.1",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.1",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "postcss": "^8.5.28",
    "prettier": "^3.4.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "turbo": "^2.3.4",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0"
  },
  "husky": {
    "hooks": {
      "commit-msg": "commitlint --edit $1",
      "pre-commit": "lint-staged",
      "pre-push": "pnpm run db:check && pnpm run typecheck && pnpm run lint"
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
