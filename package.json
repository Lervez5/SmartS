{
  "name": "school-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "School OS - a one-school School Operating System (Turborepo + pnpm monorepo).",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "build": "turbo run build",
    "start": "turbo run start",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test",
    "prepare": "husky",
    "commitlint": "commitlint",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run typecheck",
    "postinstall": "pnpm --filter school-os-api exec prisma generate 2>/dev/null || true"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.14.0",
    "@types/node": "^22.19.0",
    "autoprefixer": "^10.6.1",
    "clsx": "^2.1.1",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.1",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "postcss": "^8.5.28",
    "prettier": "^3.4.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "turbo": "^2.3.4",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0"
  },
  "husky": {
    "hooks": {
      "commit-msg": "commitlint --edit $1",
      "pre-commit": "lint-staged",
      "pre-push": "pnpm run typecheck && pnpm run lint"
    }
  }
}
